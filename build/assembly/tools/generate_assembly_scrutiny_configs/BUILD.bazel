load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    tests = [":generate_assembly_scrutiny_configs_test"],
    visibility = ["//build:__pkg__"],
)

rustc_binary_host_tool(
    name = "generate_assembly_scrutiny_configs",
    srcs = [
        "src/golden.rs",
        "src/main.rs",
    ],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/lib/assembly/config_schema",
        "//src/lib/assembly/constants",
        "//src/lib/assembly/container",
        "//src/lib/assembly/package_utils",
        "//src/lib/assembly/platform_artifacts",
        "//src/sys/pkg/lib/fuchsia-pkg",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:strum",
    ],
)

host_rustc_test(
    name = "generate_assembly_scrutiny_configs_test",
    crate = ":generate_assembly_scrutiny_configs",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = ["//third_party/rust_crates/vendor:tempfile"],
)
