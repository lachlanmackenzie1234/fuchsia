-	content, err := os.ReadFile(filename)
-	if err != nil {
-		t.Fatal(err)
-	}
-	var entry osv.Entry
-	if err := json.Unmarshal(content, &entry); err != nil {
-		t.Fatal(err)
-	}
-	return &entry
