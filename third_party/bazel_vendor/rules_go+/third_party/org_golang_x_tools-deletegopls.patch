-	// Compare with golden.
-	want, ok := golden.Get(mark.run.env.T, "", got)
-	if !ok {
-		mark.errorf("%s: missing golden file @%s", mark.note.Name, golden.id)
-	} else if diff := cmp.Diff(string(got), string(want)); diff != "" {
