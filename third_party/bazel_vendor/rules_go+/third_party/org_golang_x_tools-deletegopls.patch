-func validImportPath(path string) bool {
-	path, err := strconv.Unquote(path)
-	if err != nil {
-		return false
-	}
-	if path == "" {
-		return false
-	}
-	if path[len(path)-1] == '/' {
-		return false
-	}
-	return true
-}
