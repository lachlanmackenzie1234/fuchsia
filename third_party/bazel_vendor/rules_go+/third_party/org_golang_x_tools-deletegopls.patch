-		work, ok := s.work[token]
-		if !ok {
-			return Unmeetable // TODO(rfindley): refactor to allow the verdict to explain this result
-		}
-		if work.complete {
-			if into != nil {
-				into.Msg = work.msg
-				into.EndMsg = work.endMsg
-			}
-			return Met
-		}
-		return Unmet
-	}
