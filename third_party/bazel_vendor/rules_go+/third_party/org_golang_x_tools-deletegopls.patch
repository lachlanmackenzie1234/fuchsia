-func (fr *frob) Decode(data []byte, ptr any) {
-	rv := reflect.ValueOf(ptr).Elem()
-	if rv.Type() != fr.t {
-		panic(fmt.Sprintf("got %v, want %v", rv.Type(), fr.t))
-	}
-	rd := &reader{data}
-	if string(rd.bytes(4)) != magic {
-		panic("not a frob-encoded message")
-	}
-	fr.decode(rd, rv)
-	if len(rd.data) > 0 {
-		panic("surplus bytes")
