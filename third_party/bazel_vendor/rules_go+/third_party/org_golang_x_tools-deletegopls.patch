-	// Default to invoking *types.Func candidates. This is so function
-	// completions in an empty statement (or other cases with no expected type)
-	// are invoked by default.
-	if isFunc(cand.obj) {
-		cand.mods = append(cand.mods, invoke)
-	}
-
-	return false
-}
