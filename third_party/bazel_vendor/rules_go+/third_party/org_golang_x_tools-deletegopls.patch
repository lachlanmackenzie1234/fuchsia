-	// not a match, so downrank it. For example:
-	//
-	//  var foo func() (int, int)
-	//  a, b, c := <> // downrank "foo()" since it only returns two values
-	if !numberOfResultsCouldMatch {
-		cand.score /= 2
-		return false
