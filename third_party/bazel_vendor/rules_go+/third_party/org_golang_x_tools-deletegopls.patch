-		cfuncs[method] = fmt.Sprintf(msg, "client")
-	case "both":
-		sfuncs[method] = fmt.Sprintf(msg, "server")
-		cfuncs[method] = fmt.Sprintf(msg, "client")
-	default:
-		log.Fatalf("impossible direction %q", dir)
-	}
-}
