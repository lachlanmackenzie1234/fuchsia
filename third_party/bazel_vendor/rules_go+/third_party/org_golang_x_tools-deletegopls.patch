-	for _, mod := range changes {
-		viewSlice, ok := affectedViews[mod.URI]
-		if !ok || len(viewSlice) == 0 {
-			continue
-		}
-		view := bestViewForURI(mod.URI, viewSlice)
-		snapshot, ok := viewToSnapshot[view]
