-			for _, opt := range h.options {
-				header := strMultiply("#", level+1)
-				fmt.Fprintf(section, "%s ", header)
-				opt.Write(section)
-			}
-		}
-		var err error
-		result, err = replaceSection(result, category, section.Bytes())
-		if err != nil {
-			return nil, err
-		}
-	}
-
-	section := bytes.NewBuffer(nil)
-	for _, lens := range api.Lenses {
