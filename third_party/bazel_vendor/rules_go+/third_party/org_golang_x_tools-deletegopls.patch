-	if re != "" {
-		var err error
-		r, err = regexp.Compile(re)
-		if err != nil {
-			panic(err)
-		}
-	}
-	check := func(state State) Verdict {
-		for _, msg := range state.logs {
-			if msg.Type != typ {
-				continue
-			}
-			if r == nil || r.Match([]byte(msg.Message)) {
-				return Unmeetable
-			}
-		}
-		return Met
-	}
-	return Expectation{
-		Check:       check,
-		Description: fmt.Sprintf("no log message matching %q", re),
-	}
-}
