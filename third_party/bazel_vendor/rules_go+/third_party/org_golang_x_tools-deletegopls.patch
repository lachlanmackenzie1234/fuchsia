-		return protocol.Location{}, err // cancelled, perhaps
-	}
-	content, err := fh.Content()
-	if err != nil {
-		return protocol.Location{}, err // nonexistent or deleted ("can't happen")
-	}
-	m := protocol.NewMapper(uri, content)
-	return m.OffsetLocation(start, end)
