-					recv = nil // note: just recv = ... could result in a typed nil.
-				}
-			}
-
-			pkg := obj.Pkg()
-			if recv != nil {
-				linkName = fmt.Sprintf("(%s.%s).%s", pkg.Name(), recv.Name(), obj.Name())
