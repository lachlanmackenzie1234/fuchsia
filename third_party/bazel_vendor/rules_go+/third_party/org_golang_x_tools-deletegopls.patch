-	// Finally convert method positions to protocol form by reading the files.
-	for _, mloc := range methodLocs {
-		loc, err := offsetToLocation(ctx, snapshot, mloc.Filename, mloc.Start, mloc.End)
-		if err != nil {
-			return nil, err
-		}
-		locs = append(locs, loc)
