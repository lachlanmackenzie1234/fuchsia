-// this is a slightly modified version of flag.PrintDefaults to give us control
-func printFlagDefaults(s *flag.FlagSet) {
-	var flags [][]*flag.Flag
-	seen := map[flag.Value]int{}
-	s.VisitAll(func(f *flag.Flag) {
-		if i, ok := seen[f.Value]; !ok {
