-	// assignees match the corresponding sig result value, the signature
-	// is a match.
-	allMatch := false
-	for i := 0; i < sig.Results().Len(); i++ {
-		var assignee types.Type
-
-		// If we are completing into variadic parameters, deslice the
-		// expected variadic type.
