-func containsFileInWorkspaceLocked(v *View, m *source.Metadata) bool {
-	uris := map[span.URI]struct{}{}
-	for _, uri := range m.CompiledGoFiles {
-		uris[uri] = struct{}{}
-	}
-	for _, uri := range m.GoFiles {
-		uris[uri] = struct{}{}
