-func telemetryOnMessage(linkify bool) string {
-	format := `Thank you. Telemetry uploading is now enabled.
-
-To disable telemetry uploading, run %s.
-`
-	var runCmd = "`go run golang.org/x/telemetry/cmd/gotelemetry@latest off`"
