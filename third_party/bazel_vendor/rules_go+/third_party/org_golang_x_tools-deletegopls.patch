-		set, ok := t.sets[span.Name]
-		if !ok {
-			set = &traceSet{Name: span.Name}
-			t.sets[span.Name] = set
-		}
-		set.Last = td
-		if set.Longest == nil || set.Last.Duration > set.Longest.Duration {
-			set.Longest = set.Last
-		}
