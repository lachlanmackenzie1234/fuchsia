-		obj2 := types.NewFunc(obj.Pos(), obj.Pkg(), obj.Name(), inferred)
-		str := types.ObjectString(obj2, qf)
-		// Try to avoid overly long lines.
-		if len(str) > 60 {
-			str += "\n"
