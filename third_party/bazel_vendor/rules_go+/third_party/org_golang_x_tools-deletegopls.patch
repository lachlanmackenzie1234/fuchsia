-	state := s.state
-	s.stateMu.Unlock()
-	if state < serverInitialized {
-		return nil, nil, fmt.Errorf("addView called before server initialized")
-	}
-	options, err := s.fetchFolderOptions(ctx, uri)
-	if err != nil {
-		return nil, nil, err
