-	case reflect.Ptr: // TODO(adonovan): after go1.18, use Pointer
-		if v.IsNil() {
-			out.uint8(0)
-		} else {
-			out.uint8(1)
-			fr.elems[0].encode(out, v.Elem())
-		}
-
-	case reflect.String:
-		len := v.Len()
-		out.uint32(uint32(len))
-		if len > 0 {
-			out.data = append(out.data, v.String()...)
-		}
-
-	case reflect.Struct:
-		for i, elem := range fr.elems {
-			elem.encode(out, v.Field(i))
-		}
-
-	default:
-		panic(fr.t)
-	}
-}
