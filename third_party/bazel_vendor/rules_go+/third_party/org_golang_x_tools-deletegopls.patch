-	if ptr == nil {
-		return false
-	}
-	named, _ := ptr.Elem().(*types.Named)
-	if named == nil {
-		return false
-	}
-	obj := named.Obj()
-	// obj.Pkg is nil for the error type.
-	return obj != nil && obj.Pkg() != nil && obj.Pkg().Path() == "testing" && obj.Name() == "F"
