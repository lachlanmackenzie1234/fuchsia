-			return err
-		}
-		fmt.Print(unified)
-	}
-
-	// No flags: just print edited file content.
-	// TODO(adonovan): how is this ever useful with multiple files?
-	if !(flags.List || flags.Write || flags.Diff) {
-		os.Stdout.Write(newContent)
-	}
-
-	return nil
-}
