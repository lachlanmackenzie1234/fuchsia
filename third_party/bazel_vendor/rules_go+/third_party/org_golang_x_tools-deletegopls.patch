-			panic(fmt.Sprintf("no snapshot for view %s", view.Folder()))
-		}
-		snapshotURIs[snapshot] = append(snapshotURIs[snapshot], mod.URI)
-	}
-
-	return snapshotURIs, release, nil
-}
