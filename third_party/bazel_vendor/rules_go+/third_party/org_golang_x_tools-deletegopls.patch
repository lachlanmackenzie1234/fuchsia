-		// Find interface methods and embedded types.
-	case *ast.InterfaceType:
-		kind = protocol.Interface
-		children = fieldListSymbols(m, tf, typExpr.Methods, protocol.Method)
-		if len(children) > 0 {
-			detail = "interface{...}"
-		} else {
-			detail = "interface{}"
-		}
