-		return nil, err
-	}
-
-	// Put the upgrade code lenses above the first require block or statement.
-	rng, err := firstRequireRange(fh, pm)
-	if err != nil {
-		return nil, err
-	}
-
-	return append(lenses, []protocol.CodeLens{
