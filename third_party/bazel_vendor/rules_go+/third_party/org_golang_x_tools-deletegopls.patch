-	length := len(splt)
-
-	var b strings.Builder
-
-	// If the explanation is 2 lines, then it is of the form:
-	// # golang.org/x/text/encoding
-	// (main module does not need package golang.org/x/text/encoding)
-	if length == 2 {
-		b.WriteString(splt[1])
