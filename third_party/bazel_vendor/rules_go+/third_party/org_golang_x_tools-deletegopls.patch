-			// Wait for the didOpen notifications to be processed, then collect
-			// diagnostics.
-			var diags map[string]*protocol.PublishDiagnosticsParams
-			run.env.AfterChange(ReadAllDiagnostics(&diags))
-			for path, params := range diags {
