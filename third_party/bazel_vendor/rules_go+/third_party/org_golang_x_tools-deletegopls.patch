-				}
-				if ok {
-					actions = append(actions, action)
-				}
-			}
-
-			if want[protocol.RefactorRewrite] {
-				rewrites, err := refactorRewrite(ctx, snapshot, pkg, pgf, fh, params.Range)
-				if err != nil {
