-			cm := ""
-			if i > 0 {
-				cm = ", "
-			}
-			t.Param += fmt.Sprintf("%s%s %s", cm, t.paramnames[i], p)
-			this := t.paramnames[i]
-			if this == "_" {
-				this = "nil"
-			}
-			t.Invoke += fmt.Sprintf("%s%s", cm, this)
-		}
-		if len(t.Results) > 1 {
-			t.Result = "("
-		}
-		for i, r := range t.Results {
-			cm := ""
-			if i > 0 {
-				cm = ", "
-			}
-			t.Result += fmt.Sprintf("%s%s", cm, r)
-		}
-		if len(t.Results) > 1 {
-			t.Result += ")"
-		}
-	}
