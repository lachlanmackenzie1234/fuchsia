-// BuildLink constructs a URL with the given target, path, and anchor.
-func BuildLink(target, path, anchor string) string {
-	link := fmt.Sprintf("https://%s/%s", target, path)
-	if anchor == "" {
-		return link
-	}
-	return link + "#" + anchor
-}
