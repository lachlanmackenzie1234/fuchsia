-	// Add fields of T.
-	eachField(typ, func(v *types.Var) {
-		cb(candidate{
-			obj:         v,
-			score:       stdScore - 0.01,
-			imp:         imp,
-			addressable: addressable || isPointer(typ),
-		})
-	})
