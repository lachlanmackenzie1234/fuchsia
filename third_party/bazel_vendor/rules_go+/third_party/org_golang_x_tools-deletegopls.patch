-		if len(line) > 0 && line[0] == '-' {
-			if !list {
-				list = true
-				fmt.Fprintf(out, "//\n")
-			}
-			fmt.Fprintf(out, "//  %s\n", line)
-		} else {
-			if len(line) == 0 {
