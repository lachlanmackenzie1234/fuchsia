-func fillOffsets(td *traceSpan, start time.Time) {
-	for i := range td.Events {
-		td.Events[i].Offset = td.Events[i].Time.Sub(start)
-	}
-	for _, child := range td.ChildStartEnd {
-		if !child.Start {
-			fillOffsets(child.Span, start)
-		}
-	}
