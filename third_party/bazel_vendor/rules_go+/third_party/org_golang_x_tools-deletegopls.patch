-	if _, ok := m["selectionRange"]; ok {
-		var s protocol.DocumentSymbol
-		if err := json.Unmarshal(b, &s); err != nil {
-			return nil, err
-		}
-		return s, nil
-	}
-
-	var s protocol.SymbolInformation
-	if err := json.Unmarshal(b, &s); err != nil {
-		return nil, err
-	}
-	return s, nil
-}
