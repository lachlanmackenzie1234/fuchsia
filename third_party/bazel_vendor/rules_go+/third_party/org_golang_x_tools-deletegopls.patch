-		return // prompt is disabled
-	}
-
-	if s.telemetryMode() == "on" {
-		// Telemetry is already on -- nothing to ask about.
-		return
-	}
-
-	errorf := func(format string, args ...any) {
-		err := fmt.Errorf(format, args...)
-		event.Error(ctx, "telemetry prompt failed", err)
-	}
