-// -- implementation helpers --
-
-// UTF16Len returns the number of codes in the UTF-16 transcoding of s.
-func UTF16Len(s []byte) int {
-	var n int
-	for len(s) > 0 {
-		n++
-
-		// Fast path for ASCII.
-		if s[0] < 0x80 {
-			s = s[1:]
-			continue
-		}
-
-		r, size := utf8.DecodeRune(s)
-		if r >= 0x10000 {
-			n++ // surrogate pair
-		}
-		s = s[size:]
-	}
-	return n
-}
