-
-func chooseDocComment(decl ast.Decl, spec ast.Spec, field *ast.Field) *ast.CommentGroup {
-	if field != nil {
-		if field.Doc != nil {
-			return field.Doc
-		}
-		if field.Comment != nil {
-			return field.Comment
-		}
-		return nil
-	}
-	switch decl := decl.(type) {
-	case *ast.FuncDecl:
-		return decl.Doc
-	case *ast.GenDecl:
-		switch spec := spec.(type) {
-		case *ast.ValueSpec:
-			if spec.Doc != nil {
-				return spec.Doc
-			}
-			if decl.Doc != nil {
-				return decl.Doc
-			}
-			return spec.Comment
-		case *ast.TypeSpec:
-			if spec.Doc != nil {
-				return spec.Doc
-			}
-			if decl.Doc != nil {
-				return decl.Doc
-			}
-			return spec.Comment
-		}
-	}
-	return nil
-}
