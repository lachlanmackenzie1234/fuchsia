-	exportFiles := make(map[PackageID]string)
-	for _, pkg := range pkgs {
-		exportFiles[PackageID(pkg.ID)] = pkg.ExportFile
-		buildMetadata(pkg)
-	}
-	return exportFiles, &mapMetadataSource{meta}, nil
-}
