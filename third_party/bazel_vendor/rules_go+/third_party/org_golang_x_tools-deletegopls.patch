-	ir, iw := io.Pipe()
-	handler := &osvReader{}
-
-	var g errgroup.Group
-	g.Go(func() error {
-		defer iw.Close() // scan API doesn't close cmd.Stderr/cmd.Stdout.
-		cmd := scan.Command(ctx, args...)
