-	if !found {
-		return nil, nil
-	}
-
-	ctx, done := event.Start(ctx, "mod.Hover")
-	defer done()
-
-	// Get the position of the cursor.
-	pm, err := snapshot.ParseMod(ctx, fh)
-	if err != nil {
-		return nil, fmt.Errorf("getting modfile handle: %w", err)
