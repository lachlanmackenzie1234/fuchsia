-		if len(c.path) < 2 {
-			return false
-		}
-		n := c.path[len(c.path)-2]
-		if _, ok := n.(*ast.FuncDecl); !ok {
-			// the path should start with ast.File, ast.FuncDecl, ...
-			// but it didn't, so give up
-			return false
-		}
