-		// or is the process environment good enough?
-		if err := cmd.Start(); err != nil {
-			return err
-		}
-		return cmd.Wait()
-	})
-	g.Go(func() error {
-		return govulncheck.HandleJSON(ir, handler)
-	})
-
-	if err := g.Wait(); err != nil {
-		return nil, err
-	}
