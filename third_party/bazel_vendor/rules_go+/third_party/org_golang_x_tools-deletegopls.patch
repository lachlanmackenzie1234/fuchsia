-func markSymbols(p *Parsed, sym symbol) ([]protocol.DocumentHighlight, error) {
-	var ans []protocol.DocumentHighlight
-	for _, s := range p.symbols {
-		if s.name == sym.name {
-			kind := protocol.Read
-			if s.vardef {
-				kind = protocol.Write
-			}
-			ans = append(ans, protocol.DocumentHighlight{
-				Range: p.Range(s.start, s.length),
-				Kind:  kind,
-			})
-		}
-	}
-	return ans, nil
-}
