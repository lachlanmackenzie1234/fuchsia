-// getNames returns the names from the given list of returnVariable.
-func getNames(retVars []*returnVariable) []ast.Expr {
-	var names []ast.Expr
-	for _, retVar := range retVars {
-		names = append(names, retVar.name)
-	}
-	return names
-}
