-			kind |= kindBytes
-		}
-	case *types.Slice:
-		kind |= kindSlice
-		if t.Elem() == byteType {
-			kind |= kindBytes
-		}
-	case *types.Chan:
-		kind |= kindChan
-	case *types.Map:
-		kind |= kindMap
-	case *types.Pointer:
-		kind |= kindPtr
