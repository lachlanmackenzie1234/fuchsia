-func newFuzzyMatcher(query string) matcherFunc {
-	fm := fuzzy.NewMatcher(query)
-	return func(chunks []string) (int, float64) {
-		score := float64(fm.ScoreChunks(chunks))
-		ranges := fm.MatchedRanges()
-		if len(ranges) > 0 {
-			return ranges[0], score
-		}
-		return -1, score
-	}
-}
