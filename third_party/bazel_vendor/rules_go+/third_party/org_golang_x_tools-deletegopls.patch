-		Args:       append([]string{"-m", "-u", "-json"}, modules...),
-		WorkingDir: filepath.Dir(uri.Filename()),
-		ModFlag:    "readonly",
-	})
-	if err != nil {
-		return nil, err
-	}
-
-	upgrades := map[string]string{}
-	for dec := json.NewDecoder(stdout); dec.More(); {
-		mod := &gocommand.ModuleJSON{}
-		if err := dec.Decode(mod); err != nil {
