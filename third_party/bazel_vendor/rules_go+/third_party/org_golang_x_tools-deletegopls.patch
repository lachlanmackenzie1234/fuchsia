-		case InRaw:
-			if c == '`' {
-				state = oldState
-			}
-		case InString:
-			if c == '"' && !isEscaped(p.buf[:n]) {
-				state = oldState
-			}
-		case SeenLeft:
-			if c == '`' {
-				oldState = state // it's SeenLeft, but a little clearer this way
-				state = InRaw
-				continue
-			}
-			if c == '"' {
