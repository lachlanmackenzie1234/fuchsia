-	var err error
-	s.Range, err = m.NodeRange(tf, spec)
-	if err != nil {
-		return protocol.DocumentSymbol{}, err
-	}
-	s.SelectionRange, err = m.NodeRange(tf, spec.Name)
-	if err != nil {
-		return protocol.DocumentSymbol{}, err
