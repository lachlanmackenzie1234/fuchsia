-func (s *snapshot) addKnownSubdirs(patterns map[string]unit, wsDirs []string) {
-	s.mu.Lock()
-	defer s.mu.Unlock()
-
-	s.files.Dirs().Range(func(dir string) {
-		for _, wsDir := range wsDirs {
-			if source.InDir(wsDir, dir) {
-				patterns[dir] = unit{}
-			}
-		}
-	})
-}
