-		o.SupportedResourceOperations = caps.Workspace.WorkspaceEdit.ResourceOperations
-	}
-	if c := caps.TextDocument.Completion; c.CompletionItem.SnippetSupport {
-		o.InsertTextFormat = protocol.SnippetTextFormat
