-	if len(words) <= 1 || len(words[len(words)-2]) == 1 && words[len(words)-2][0] == '|' {
-		for _, kw := range keywords {
-			if weakMatch(kw, string(pattern)) != 0 {
-				ans.Items = append(ans.Items, protocol.CompletionItem{
-					Label:  kw,
-					Kind:   protocol.KeywordCompletion,
-					Detail: "keyword",
-				})
-			}
-		}
-	}
-	return ans, nil
-}
