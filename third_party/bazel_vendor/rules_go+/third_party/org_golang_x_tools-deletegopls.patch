-			// imeth is the abstract method (e.g. I.f)
-			// and key.RHS is the concrete coupling type (e.g. D).
-			if !r.changeMethods {
-				r.errorf(from.Pos(), "renaming this method %q to %q",
-					from.Name(), r.to)
-				var pos token.Pos
-				var iface string
-
-				I := recv(imeth).Type()
-				if named, ok := I.(*types.Named); ok {
-					pos = named.Obj().Pos()
-					iface = "interface " + named.Obj().Name()
