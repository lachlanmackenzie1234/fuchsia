-func (s *signature) Format() string {
-	var b strings.Builder
-	b.WriteByte('(')
-	for i, p := range s.params {
-		if i > 0 {
-			b.WriteString(", ")
-		}
-		b.WriteString(p)
-	}
-	b.WriteByte(')')
-
-	// Add space between parameters and results.
-	if len(s.results) > 0 {
-		b.WriteByte(' ')
-	}
-	if s.needResultParens {
-		b.WriteByte('(')
-	}
-	for i, r := range s.results {
-		if i > 0 {
-			b.WriteString(", ")
-		}
-		b.WriteString(r)
-	}
-	if s.needResultParens {
-		b.WriteByte(')')
-	}
-	return b.String()
-}
