-func findModuleReference(mf *modfile.File, ver module.Version) *modfile.Line {
-	for _, req := range mf.Require {
-		if req.Mod == ver {
-			return req.Syntax
-		}
-	}
-	for _, ex := range mf.Exclude {
-		if ex.Mod == ver {
-			return ex.Syntax
-		}
-	}
-	for _, rep := range mf.Replace {
-		if rep.New == ver || rep.Old == ver {
-			return rep.Syntax
-		}
-	}
-	return nil
-}
