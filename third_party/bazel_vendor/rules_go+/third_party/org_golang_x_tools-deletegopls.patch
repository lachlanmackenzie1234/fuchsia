-			Registrations: registrations,
-		}); err != nil {
-			return err
-		}
-	}
-
-	// Ask (maybe) about enabling telemetry. Do this asynchronously, as it's OK
-	// for users to ignore or dismiss the question.
-	go s.maybePromptForTelemetry(ctx, options.TelemetryPrompt)
-
-	return nil
-}
