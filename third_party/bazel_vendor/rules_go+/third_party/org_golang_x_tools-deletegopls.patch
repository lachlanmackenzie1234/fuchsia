-
-	// Special case: for types that satisfy error, report builtin.go (see #59527).
-	if types.Implements(queryType, errorInterfaceType) {
-		loc, err := errorLocation(ctx, snapshot)
-		if err != nil {
-			return nil, err
-		}
-		locs = append(locs, loc)
-	}
