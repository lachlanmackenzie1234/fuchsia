-		release, ok, err := acquireLockFile(name)
-		if err != nil {
-			t.Fatal(err)
-		}
-		return release, ok
-	}
-
-	release, ok := acquire()
-	if !ok {
-		t.Fatal("failed to Acquire")
-	}
-	if release2, ok := acquire(); ok {
-		release()
-		release2()
-		t.Fatalf("Acquire succeeded unexpectedly")
-	}
-
-	release()
-	release3, ok := acquire()
-	release3()
-	if !ok {
-		t.Fatalf("failed to Acquire")
-	}
-}
