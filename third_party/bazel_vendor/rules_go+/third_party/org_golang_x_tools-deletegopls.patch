-		_, ok := s.workspaceModFiles[modURI]
-		if !ok {
-			return false
-		}
-
-		uris := map[span.URI]struct{}{}
-		for _, uri := range m.CompiledGoFiles {
-			uris[uri] = struct{}{}
-		}
-		for _, uri := range m.GoFiles {
