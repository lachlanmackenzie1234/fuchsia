-	// Never give type conversions like "untyped int()".
-	if isUntyped(T) {
-		return
-	}
-
-	snip.WriteText("(")
-	snip.WriteFinalTabstop()
-	snip.WriteText(")")
-
-	nonSnippet := typeName + "()"
-
-	c.items = append(c.items, CompletionItem{
-		Label:               nonSnippet,
-		InsertText:          nonSnippet,
-		Detail:              T.String(),
