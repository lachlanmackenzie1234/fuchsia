-					r.errorf(from.Pos(), "renaming this method %q to %q",
-						from.Name(), r.to)
-					if delta == 0 {
-						// analogous to same-block conflict
-						r.errorf(keyPos, "\twould make the %s method of %s invoked via interface %s ambiguous",
