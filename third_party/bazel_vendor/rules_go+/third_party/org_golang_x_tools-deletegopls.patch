-	attempts++
-
-	pendingContent := []byte(fmt.Sprintf("%s %d", pPending, attempts))
-	if err := os.WriteFile(promptFile, pendingContent, 0666); err != nil {
-		errorf("writing pending state: %v", err)
-		return
-	}
