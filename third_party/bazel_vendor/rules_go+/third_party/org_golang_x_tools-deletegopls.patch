-		// If supplied, translate the package path to an import path in the source
-		// package.
-		if pkgPath != "" {
-			if srcImp := importsByPkgPath[pkgPath]; srcImp != "" {
-				impPath = srcImp
-			}
-			if pkgPath == m.PkgPath {
-				return ""
-			}
-		}
-		if localName, ok := localNames[impPath]; ok && impPath != "" {
-			return string(localName)
