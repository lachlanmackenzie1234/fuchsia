-	// Extract the package-level candidates using a quick parse.
-	var g errgroup.Group
-	for _, path := range paths {
-		m := known[source.PackagePath(path)]
-		for _, uri := range m.CompiledGoFiles {
-			uri := uri
-			g.Go(func() error {
