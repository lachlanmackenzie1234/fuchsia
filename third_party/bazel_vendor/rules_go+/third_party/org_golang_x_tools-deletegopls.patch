-// alreadyImports reports whether f has an import with the specified path.
-func alreadyImports(f *ast.File, path source.ImportPath) bool {
-	for _, s := range f.Imports {
-		if source.UnquoteImportPath(s) == path {
-			return true
-		}
-	}
-	return false
-}
