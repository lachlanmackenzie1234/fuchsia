-		}
-		sym := symbol{name: f, kind: kind, start: at, length: utf8.RuneCount([]byte(f))}
-		if kind == protocol.Variable && len(p.stack) > 1 {
-			if pipe, ok := p.stack[len(p.stack)-2].(*parse.PipeNode); ok {
-				for _, y := range pipe.Decl {
-					if x == y {
-						sym.vardef = true
-					}
-				}
-			}
-		}
