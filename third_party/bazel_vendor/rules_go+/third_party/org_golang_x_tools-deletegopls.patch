-
-	for isError, want := range map[bool]uint64{false: 1, true: 0} {
-		if got := totalLatencySamples(t, operation, isError); got != want {
-			t.Errorf("totalLatencySamples(operation=%v, isError=%v) = %d, want %d", operation, isError, got, want)
-		}
-	}
-}
