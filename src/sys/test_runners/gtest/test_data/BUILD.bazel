load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")

package(default_applicable_licenses = ["//:license"])

# We don't have gunit in-tree, so this main function will replace all gunit
# flags with gtest flags and run the tests using gtest framework.
fx_cc_library(
    name = "gunit_main",
    testonly = True,
    srcs = ["gunit_main.cc"],
    implementation_deps = [
        "//src/lib/fxl",
        "//src/lib/fxl/test:test_settings",
    ],
    visibility = ["//src/sys/test_runners/gunit/tests:__pkg__"],
    deps = ["@com_google_googletest//:gtest"],
    alwayslink = True,
)

fx_cc_binary(
    name = "echo_gtest_client",
    testonly = True,
    srcs = ["echo_test.cc"],
    build_flags = ["//build/config/lto:no-fat-lto-objects-linking"],
    deps = [
        "//examples/components/routing/fidl:echo_hlcpp",
        "//sdk/lib/async-default",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/sys/cpp",
        "//src/lib/fxl/test:gtest_main",
    ],
)

# Generates two executables. One for gtest and other for gunit.
