rustc_test("test_bin") {
  sources = [ "src/lib.rs" ]
  output_name = "debug_dash_launcher_test"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.dash:fuchsia.dash_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
  ]
}
