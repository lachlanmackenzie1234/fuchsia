load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "timekeeper-persistence.core_shard.cml",
        "timekeeper-wake-alarms.core_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/clock_manager.rs",
        "src/diagnostics/cobalt.rs",
        "src/diagnostics/composite.rs",
        "src/diagnostics/fake.rs",
        "src/diagnostics/inspect.rs",
        "src/diagnostics/mod.rs",
        "src/enums.rs",
        "src/estimator/frequency.rs",
        "src/estimator/kalman_filter.rs",
        "src/estimator/mod.rs",
        "src/main.rs",
        "src/power_topology_integration.rs",
        "src/reachability.rs",
        "src/rtc.rs",
        "src/rtc_testing.rs",
        "src/time_source.rs",
        "src/time_source_manager.rs",
    ],
    crate_name = "timekeeper",
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    visibility = ["//src/sys/time/testing:__pkg__"],
    deps = [
        # The generated structured config data schema.
        ":timekeeper-config",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.hardware.hrtimer:fuchsia.hardware.hrtimer_rust",
        "//sdk/fidl/fuchsia.hardware.rtc:fuchsia.hardware.rtc_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_rust",
        "//sdk/fidl/fuchsia.net.reachability:fuchsia.net.reachability_rust",
        "//sdk/fidl/fuchsia.power.system:fuchsia.power.system_rust",
        "//sdk/fidl/fuchsia.time:fuchsia.time_rust",
        "//sdk/fidl/fuchsia.time.alarms:fuchsia.time.alarms_rust",
        "//sdk/fidl/fuchsia.time.external:fuchsia.time.external_rust",
        "//sdk/fidl/fuchsia.time.test:fuchsia.time.test_rust",
        "//sdk/rust/zx",
        "//src/lib/async-utils",
        "//src/lib/cobalt/rust/builders",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fidl/rust/fidl-contrib",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/fuchsia-sync",
        "//src/lib/trace/rust:trace",
        "//src/lib/trace/rust:trace-provider",
        "//src/sys/time/lib/inspect-writable",
        "//src/sys/time/lib/time-util",
        "//src/sys/time/lib/time_metrics_registry",
        "//src/sys/time/timekeeper/adjust:time_adjust",
        "//src/sys/time/timekeeper/alarms",
        "//src/sys/time/timekeeper/persistence:lib",
        "//src/sys/time/timekeeper/pretty:time_pretty",
        "//third_party/cobalt/src/lib/client/rust:cobalt-client",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Kept for bazel2gn `output_name`, which `meta/unittests.cml` (`program.binary`) expects.
    crate_name = "timekeeper_bin_test",
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/test_util",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:tempfile",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "timekeeper",
)

fx_component_manifest(
    name = "manifest",
    component_name = "timekeeper",
    includes = [
        "config.shard.cml",
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/syslog:offer.shard",
        "//sdk/lib/trace:client.shard",
    ],
    manifest = "meta/service.cml",
)

fuchsia_structured_config_rust_lib(
    name = "timekeeper-config",
    cm_label = ":manifest",
    visibility = ["//src/sys/time:__pkg__"],
)

fx_component(
    name = "service",
    compiled_manifest = ":manifest",
    visibility = ["//src/sys/time:__pkg__"],
    deps = [":bin_packaged_bin"],
)
