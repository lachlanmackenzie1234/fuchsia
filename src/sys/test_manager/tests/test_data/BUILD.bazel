fx_test(
    name = "debug-data-test_test",
    package = ":debug-data-test",
    # TODO: https://fxbug.dev/42068707: Ensure that this test does not run
    # when profile variant is selected. It adds a use for
    # fuchsia.debugdata.Publisher capability via debug for coverage variant,
    # and profile variant adds a use for this capability via diagnostics
    # dictionary, which results in duplicate use target protocol error.
    # This mirrors the GN `!is_profile` guards, which keep gating the GN copy.
    # @bazel2gn:skip
    target_compatible_with = select({
        "//build/bazel/config/select/is_profile:true": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//src/sys:__pkg__"],
)

