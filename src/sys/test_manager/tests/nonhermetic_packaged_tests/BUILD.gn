rustc_test("echo_test_bin") {
  sources = [ "echo_test.rs" ]
  output_name = "echo_test"
  source_root = "echo_test.rs"
  edition = "2024"
  deps = [
    "//examples/components/routing/fidl:echo_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
  ]
}
