import("//build/components.gni")

fuchsia_package("process-resolver") {
  visibility = [
    ":*",
    "//bundles/assembly/*",
  ]
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [ ":process-resolver-unittests" ]
}

