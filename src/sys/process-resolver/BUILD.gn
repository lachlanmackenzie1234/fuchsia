rustc_binary("bin") {
  sources = [
    "src/main.rs",
    "src/resolve/mod.rs",
    "src/resolve/serve.rs",
  ]
  configs += [ "//build/config/rust:bootfs" ]
  output_name = "process_resolver"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.ldsvc:fuchsia.ldsvc_rust",
    "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
    "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//src/lib/fuchsia-url",
    "//src/sys/lib/library_loader",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component_manifest("component-manifest") {
  component_name = "process_resolver"
  manifest = "meta/process_resolver.cml"
}

fuchsia_component("component") {
  cm_label = ":component-manifest"
  deps = [ ":bin" ]
}
if (is_fuchsia) {
  rustc_test("process_resolver_bin_test") {
    sources = [
      "src/main.rs",
      "src/resolve/mod.rs",
      "src/resolve/serve.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
             "//sdk/fidl/fuchsia.ldsvc:fuchsia.ldsvc_rust",
             "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
             "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
             "//sdk/rust/zx",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-component",
             "//src/lib/fuchsia-fs",
             "//src/lib/fuchsia-url",
             "//src/sys/lib/library_loader",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:log",
           ] + [ "//src/lib/fuchsia-async" ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust:bootfs" ]
  }
}

fuchsia_unittest_package("process-resolver-unittests") {
  package_name = "process-resolver-unittests-gn"
  component_name = "process-resolver-unittests"
  deps = [ ":process_resolver_bin_test" ]
  visibility = [
    ":*",
    "//src/sys:*",
  ]
}
