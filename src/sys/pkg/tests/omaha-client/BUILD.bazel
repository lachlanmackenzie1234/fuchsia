load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

# `omaha-client-test-root`, `omaha-client-test-driver`, and
# `omaha-client-integration-tests` stay in BUILD.gn above the bazel2gn sentinel
# because `omaha-client-integration-tests` packages GN-only
# `//src/connectivity/network/dns:component`,
# `//src/connectivity/network/netstack3:component-for-tests`, and
# `//src/sys/stash:stash2_v2`.
rustc_test(
    name = "driver",
    srcs = ["src/lib.rs"],
    compile_data = ["src/test_private_key.pem"],
    crate_name = "omaha_client_integration_test",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_rust",
        "//sdk/fidl/fuchsia.net.http:fuchsia.net.http_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
        "//sdk/fidl/fuchsia.update.channel:fuchsia.update.channel_rust",
        "//sdk/fidl/fuchsia.update.channelcontrol:fuchsia.update.channelcontrol_rust",
        "//sdk/fidl/fuchsia.update.config:fuchsia.update.config_rust",
        "//sdk/fidl/fuchsia.update:fuchsia.update_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/hierarchy/rust:diagnostics-hierarchy",
        "//src/lib/diagnostics/reader/rust",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        # GN depends on `//src/lib/fuchsia-component-test`, which bundles
        # `realm_builder_server:realm_builder_server_component` for the GN test
        # package; Bazel depends on `:fuchsia-component-test-lib` directly.
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-sync",
        "//src/lib/fuchsia-url",
        "//src/sys/lib/cm_rust",
        "//src/sys/pkg/fidl/fuchsia.update.installer:fuchsia.update.installer_rust",
        "//src/sys/pkg/fidl/fuchsia.update.verify:fuchsia.update.verify_rust",
        "//src/sys/pkg/lib/fidl-fuchsia-update-installer-ext",
        "//src/sys/pkg/lib/fuchsia-pkg-testing",
        "//src/sys/pkg/lib/update-package",
        "//src/sys/pkg/testing/mock-crash-reporter:lib",
        "//src/sys/pkg/testing/mock-health-verification",
        "//src/sys/pkg/testing/mock-installer",
        "//src/sys/pkg/testing/mock-omaha-server-fuchsia",
        "//src/sys/pkg/testing/mock-paver",
        "//src/sys/pkg/testing/mock-reboot",
        "//src/sys/pkg/testing/mock-resolver",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:mock-omaha-server",
        "//third_party/rust_crates/vendor:omaha_client",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
