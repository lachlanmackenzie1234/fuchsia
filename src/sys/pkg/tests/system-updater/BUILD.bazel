load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

# `system-updater-test` and `system-updater-integration-tests` stay in BUILD.gn
# above the bazel2gn sentinel because they depend on GN-only
# `//src/storage/testing/driver_test_realm/meta/client.shard.cml`,
# `//src/storage/testing:storage_driver_test_realm`, and
# `//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component`.
rustc_test(
    name = "driver",
    srcs = [
        "src/board.rs",
        "src/cancel.rs",
        "src/cobalt_metrics.rs",
        "src/commits_images.rs",
        "src/epoch.rs",
        "src/fetch_packages.rs",
        "src/history.rs",
        "src/lib.rs",
        "src/mode_force_recovery.rs",
        "src/mode_normal.rs",
        "src/ota_manifest.rs",
        "src/overwrites_blobs.rs",
        "src/progress_reporting.rs",
        "src/reboot_controller.rs",
        "src/retained_packages.rs",
        "src/update_package.rs",
        "src/verify_existing_blobs.rs",
        "src/writes_firmware.rs",
        "src/writes_images.rs",
    ],
    crate_name = "system_updater_test",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_rust",
        "//sdk/fidl/fuchsia.net.http:fuchsia.net.http_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/fidl/fuchsia.pkg.garbagecollector:fuchsia.pkg.garbagecollector_rust",
        "//sdk/fidl/fuchsia.pkg.internal:fuchsia.pkg.internal_rust",
        "//sdk/fidl/fuchsia.storage.blobfs:fuchsia.storage.blobfs_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        # GN depends on the `fuchsia-component-test` group, which bundles the
        # Rust library with `realm_builder_server_component` and `includes`;
        # Bazel depends on the Rust library target directly.
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-sync",
        "//src/lib/fuchsia-url",
        "//src/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
        "//src/sys/lib/cm_rust",
        "//src/sys/lib/fidl-fuchsia-pkg-ext",
        "//src/sys/pkg/fidl/fuchsia.update.installer:fuchsia.update.installer_rust",
        "//src/sys/pkg/lib/fidl-fuchsia-update-installer-ext",
        "//src/sys/pkg/lib/fuchsia-hash",
        "//src/sys/pkg/lib/fuchsia-merkle",
        "//src/sys/pkg/lib/fuchsia-pkg-testing",
        "//src/sys/pkg/lib/metrics:cobalt_sw_delivery_registry_rustlib",
        "//src/sys/pkg/lib/update-package",
        "//src/sys/pkg/testing/blobfs-ramdisk",
        "//src/sys/pkg/testing/mock-crash-reporter:lib",
        "//src/sys/pkg/testing/mock-metrics",
        "//src/sys/pkg/testing/mock-paver",
        "//src/sys/pkg/testing/mock-reboot",
        "//src/sys/pkg/testing/mock-resolver",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:http",
        "//third_party/rust_crates/vendor:maplit",
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//third_party/rust_crates/vendor:ring",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
        "//third_party/rust_crates/vendor:test-case",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
