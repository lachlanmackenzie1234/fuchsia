load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# Preserve non-crate GN resource dependencies so downstream GN test packages
# continue collecting their packaged resource metadata.
# @bazel2gn:raw_attribute:deps += [ "//src/sys/pkg/lib/fuchsia-pkg-testing/certs", "//src/sys/pkg/tests/pkg-resolver:empty-repo" ]
rustc_library(
    name = "isolated-ota-env",
    testonly = True,
    srcs = ["src/lib.rs"],
    # In GN, `testonly = true` targets omit `clippy_warn_production` (which
    # enables `clippy::collection_is_never_read`), whereas Bazel
    # `clippy_warn_all` unconditionally bakes `_CLIPPY_WARN_PRODUCTION` in and
    # trips `collection_is_never_read` on `src/lib.rs:264`.
    disable_clippy = True,  # @bazel2gn:skip
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/sys/pkg/tests/isolated-ota:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        # GN depends on the `:fuchsia-component-test` group (which bundles
        # `:includes` and `realm_builder_server_component`); Bazel depends on
        # the Rust library target directly.
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/lib/fuchsia-url",
        "//src/sys/lib/fidl-fuchsia-pkg-ext",
        "//src/sys/pkg/lib/fuchsia-merkle",
        "//src/sys/pkg/lib/fuchsia-pkg-testing",
        "//src/sys/pkg/lib/isolated-ota",
        "//src/sys/pkg/testing/mock-omaha-server-fuchsia",
        "//src/sys/pkg/testing/mock-paver",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:http",
        "//third_party/rust_crates/vendor:mock-omaha-server",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
