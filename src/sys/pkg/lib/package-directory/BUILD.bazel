load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "package-directory",
    srcs = [
        "src/lib.rs",
        "src/meta_as_dir.rs",
        "src/meta_subdir.rs",
        "src/non_meta_subdir.rs",
        "src/root_dir.rs",
        "src/root_dir_cache.rs",
    ],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/storage/benchmarks/fuchsia/pkgdir-component:__pkg__",
        "//src/sys/component_manager:__pkg__",
        "//src/sys/pkg:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//src/lib/collections/packed",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",  # @bazel2gn:path_overwrite://src/lib/diagnostics/inspect/rust
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-fs",
        "//src/storage/lib/vfs/rust:vfs",
        "//src/sys/pkg/lib/blobfs",
        "//src/sys/pkg/lib/far/rust:fuchsia-archive",
        "//src/sys/pkg/lib/fuchsia-hash",
        "//src/sys/pkg/lib/fuchsia-pkg",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:static_assertions",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "package-directory_test",
    crate = ":package-directory",
    # Sets GN `output_name` to match `program.binary` in
    # `meta/package-directory-lib-test.cml` (ignored by `rules_rust` when
    # `crate` is set).
    crate_name = "package_directory_lib_test",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-url",
        "//src/sys/pkg/lib/fuchsia-merkle",
        "//src/sys/pkg/lib/fuchsia-pkg-testing",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:pretty_assertions",
    ],
)

fx_packaged_binary(
    name = "package-directory_test_packaged_bin",
    testonly = True,
    binary = ":package-directory_test",
    binary_name = "package_directory_lib_test",
)

fx_component_manifest(
    name = "test-component-manifest",
    testonly = True,
    component_name = "package-directory-lib-test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/storage/lib/fs_management:client.shard.cml",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/package-directory-lib-test.cml",
)

fx_test_component(
    name = "test-component",
    compiled_manifest = ":test-component-manifest",
    deps = [":package-directory_test_packaged_bin"],
)

fx_package(
    name = "package-directory-tests",
    package_name = "package-directory-tests",
    test_components = [":test-component"],
)

fx_test(
    name = "package-directory-tests_test",
    package = ":package-directory-tests",
)
