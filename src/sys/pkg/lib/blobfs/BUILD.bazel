load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

# The test package (`:blobfs-lib-tests`) stays in BUILD.gn because it packages
# `//src/storage/fxfs:fxfs_component` and
# `//src/storage/testing:storage_driver_test_realm`, which are GN-only.
rustc_library(
    name = "blobfs",
    srcs = [
        "src/lib.rs",
        "src/mock.rs",
    ],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/storage/benchmarks/fuchsia/pkgdir-component:__pkg__",
        "//src/sys/pkg:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-fs",
        "//src/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
        "//src/storage/lib/vfs/rust:vfs",
        "//src/storage/lib/vmo-blob",
        "//src/sys/pkg/lib/fuchsia-hash",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "blobfs_test",
    crate = ":blobfs",
    # Synced to GN `output_name` to match `program.binary` in
    # `meta/blobfs-lib-test.cml`.
    crate_name = "blobfs_lib_test",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/storage/lib/delivery_blob",
        "//src/sys/pkg/lib/fuchsia-merkle",
        "//src/sys/pkg/testing/blobfs-ramdisk",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:test-case",
    ],
)
