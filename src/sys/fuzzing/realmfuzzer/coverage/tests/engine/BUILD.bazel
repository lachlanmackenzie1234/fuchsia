load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

# GN dependency //build/validate:non_production_tag has no Bazel equivalent.
# @bazel2gn:raw_attribute:deps += [ "//build/validate:non_production_tag" ]
rustc_binary(
    name = "engine",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "realmfuzzer_coverage_test_engine",
    edition = "2024",
    # GN applies clippy_warn_default to testonly Rust targets implicitly,
    # whereas Bazel rustc_binary defaults to clippy_warn_production.
    # @bazel2gn:skip
    lint_config = "//build/config/rust/lints:clippy_warn_default",
    tags = ["manual"],
    visibility = ["//src/sys/fuzzing/realmfuzzer/coverage/tests:__pkg__"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/sys/fuzzing/fidl:fuchsia.fuzzer_rust",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)
