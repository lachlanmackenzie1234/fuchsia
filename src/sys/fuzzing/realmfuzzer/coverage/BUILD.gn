import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  testonly = true
  sources = [
    "src/aggregator.rs",
    "src/main.rs",
    "src/options.rs",
  ]
  output_name = "realmfuzzer_coverage"
  edition = "2024"
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/sys/fuzzing/fidl:fuchsia.fuzzer_rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:event-listener",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  deps += [ "//build/validate:non_production_tag" ]
}

fuchsia_component_manifest("coverage-manifest") {
  testonly = true
  component_name = "coverage"
  manifest = "meta/coverage.cml"
}

fuchsia_component("coverage") {
  testonly = true
  cm_label = ":coverage-manifest"
  visibility = [
    ":*",
    "//src/sys/fuzzing/realmfuzzer/coverage/tests:*",
    "//src/sys/fuzzing/realmfuzzer/tests:*",
  ]
  deps = [ ":bin" ]
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [
      "src/aggregator.rs",
      "src/main.rs",
      "src/options.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/rust/zx",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-component",
             "//src/sys/fuzzing/fidl:fuchsia.fuzzer_rust",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:event-listener",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:log",
           ] +
           [
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-runtime",
           ]
    source_root = "src/main.rs"
    output_name = "realmfuzzer_coverage_bin_test"
  }
}

fuchsia_component_manifest("unittests-manifest") {
  testonly = true
  component_name = "unittests"
  manifest = "meta/unittests.cml"
}

fuchsia_test_component("unittests") {
  cm_label = ":unittests-manifest"
  deps = [ ":bin_test" ]
}

fuchsia_test_package("unittests-pkg") {
  package_name = "realmfuzzer-coverage-unittests-gn"
  test_components = [ ":unittests" ]
}
