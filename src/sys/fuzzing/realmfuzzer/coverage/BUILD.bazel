load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

# GN dependency //build/validate:non_production_tag has no Bazel equivalent.
# @bazel2gn:raw_attribute:deps += [ "//build/validate:non_production_tag" ]
rustc_binary(
    name = "bin",
    testonly = True,
    srcs = [
        "src/aggregator.rs",
        "src/main.rs",
        "src/options.rs",
    ],
    crate_name = "realmfuzzer_coverage",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/fuzzing/fidl:fuchsia.fuzzer_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:event-listener",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    testonly = True,
    binary = ":bin",
    binary_name = "realmfuzzer_coverage",
)

fx_component_manifest(
    name = "coverage-manifest",
    testonly = True,
    component_name = "coverage",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/coverage.cml",
)

fx_component(
    name = "coverage",
    testonly = True,
    compiled_manifest = ":coverage-manifest",
    visibility = [
        "//src/sys/fuzzing/realmfuzzer/coverage/tests:__pkg__",
        "//src/sys/fuzzing/realmfuzzer/tests:__pkg__",
    ],
    deps = [":bin_packaged_bin"],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Keep crate_name so bazel2gn sets output_name to match meta/unittests.cml's program.binary.
    crate_name = "realmfuzzer_coverage_bin_test",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-runtime",
    ],
)

fx_packaged_binary(
    name = "bin_test_packaged_bin",
    testonly = True,
    binary = ":bin_test",
    binary_name = "realmfuzzer_coverage_bin_test",
)

fx_component_manifest(
    name = "unittests-manifest",
    testonly = True,
    component_name = "unittests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/unittests.cml",
)

fx_test_component(
    name = "unittests",
    compiled_manifest = ":unittests-manifest",
    deps = [":bin_test_packaged_bin"],
)

fx_package(
    name = "unittests-pkg",
    package_name = "realmfuzzer-coverage-unittests",
    test_components = [":unittests"],
)

fx_test(
    name = "realmfuzzer-coverage-unittests",
    package = ":unittests-pkg",
    visibility = ["//src/sys:__pkg__"],
)
