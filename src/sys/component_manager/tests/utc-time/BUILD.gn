import("//build/component/config.gni")
import("//build/components.gni")

group("utc-time") {
  testonly = true
  deps = [ ":tests" ]
}

group("tests") {
  testonly = true
  deps = [ ":utc-time-tests" ]
}

# Retained in GN because this test package uses RealmBuilder
# (//src/lib/fuchsia-component-test/realm_builder_server is not in Bazel) and
# embeds the GN-only component_config (:component_manager_config).
fuchsia_component("integration-test-component") {
  testonly = true
  manifest = "meta/integration-test.cml"
  deps = [ ":integration_test_bin" ]
}

fuchsia_component("maintainer-component") {
  testonly = true
  manifest = "meta/maintainer.cml"
  deps = [ ":maintainer_bin" ]
}

fuchsia_component("time-client") {
  testonly = true
  manifest = "meta/time_client.cml"
  deps = [ ":time_client_bin" ]
}

fuchsia_component("realm") {
  testonly = true
  manifest = "meta/realm.cml"
}

component_config("component_manager_config") {
  sources = [ "cm_config.json5" ]
}

fuchsia_component("component_manager") {
  testonly = true
  deps = [
    ":component_manager_config",
    "//src/sys/component_manager:bin_with_tracing",
  ]
  manifest = "//src/sys/component_manager/meta/component_manager.cml"
}

# Run with `fx test utc-time-tests`.
fuchsia_test_package("utc-time-tests") {
  test_components = [ ":integration-test-component" ]
  deps = [
    ":component_manager",
    ":maintainer-component",
    ":realm",
    ":time-client",
  ]
}

