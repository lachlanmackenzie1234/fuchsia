import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [
    "src/accessor.rs",
    "src/instance.rs",
    "src/main.rs",
    "src/store.rs",
  ]
  output_name = "stash"
  edition = "2024"
  visibility = [
    ":*",
    "//src/connectivity/bluetooth/core/bt-gap:*",
  ]
  deps = [
    ":measure_tape_for_stash",
    "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
    "//sdk/fidl/fuchsia.stash:fuchsia.stash_rust",
    "//sdk/rust/zx",
    "//src/lib/diagnostics/inspect/runtime/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia_nix",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:byteorder",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

measure_tape("measure_tape_for_stash") {
  fidls = [
    "//sdk/fidl/fuchsia.stash",
    "//sdk/fidl/fuchsia.mem",
  ]
  target_binding = "rust"
  target_types = [
    "fuchsia.stash/ListItem",
    "fuchsia.stash/KeyValue",
  ]
}

fuchsia_component_manifest("stash_secure_v2-manifest") {
  component_name = "stash_secure"
  manifest = "meta/stash_secure.cml"
}

fuchsia_component("stash_secure_v2") {
  cm_label = ":stash_secure_v2-manifest"
  visibility = [
    ":*",
    "//src/chromium/*",
    "//src/connectivity/*",
    "//src/sys/*",
    "//third_party/boringssl:*",
  ]
  deps = [ ":bin" ]
}

fuchsia_component_manifest("stash_v2-manifest") {
  component_name = "stash"
  manifest = "meta/stash.cml"
}

fuchsia_component("stash_v2") {
  cm_label = ":stash_v2-manifest"
  visibility = [
    ":*",
    "//sdk/ctf/tests/fidl/fuchsia.intl/testing/realm-factory:*",
    "//sdk/ctf/tests/fidl/fuchsia.settings/testing/realm-factory:*",
    "//src/connectivity/wlan/lib/storage:*",
    "//src/sys/stash/tests/*",
  ]
  deps = [ ":bin" ]
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [
      "src/accessor.rs",
      "src/instance.rs",
      "src/main.rs",
      "src/store.rs",
    ]
    edition = "2024"
    deps = [
             ":measure_tape_for_stash",
             "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
             "//sdk/fidl/fuchsia.stash:fuchsia.stash_rust",
             "//sdk/rust/zx",
             "//src/lib/diagnostics/inspect/runtime/rust",
             "//src/lib/diagnostics/inspect/rust",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-component",
             "//src/lib/fuchsia_nix",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:byteorder",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:log",
           ] + [ "//third_party/rust_crates:tempfile" ]
    source_root = "src/main.rs"
    output_name = "stash_bin_test"
  }
}

fuchsia_component_manifest("stash-tests-manifest") {
  testonly = true
  component_name = "stash-tests"
  manifest = "meta/stash_bin_test.cml"
}

fuchsia_test_component("stash-tests-component") {
  cm_label = ":stash-tests-manifest"
  deps = [ ":bin_test" ]
}

fuchsia_test_package("stash-tests-package") {
  package_name = "stash-tests-gn"
  test_components = [ ":stash-tests-component" ]
}
