load("//build/bazel/rules/components:fx_component.bzl", "fx_component", "fx_component_manifest")
load("//build/bazel/rules/components:structured_config.bzl", "fuchsia_structured_config_rust_lib")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

# @bazel2gn:skip
test_suite(
    name = "tests",
    tests = [":vsock_service-tests"],
    visibility = ["//src/paravirtualization:__pkg__"],
)

exports_files(
    [
        "meta/vsock_service.bootstrap_shard.cml",
        "meta/vsock_service.core_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

fx_component_manifest(
    name = "manifest",
    component_name = "vsock_service",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/vsock_service.cml",
)

fuchsia_structured_config_rust_lib(
    name = "vsock_service_config",
    cm_label = ":manifest",
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_name = "vsock_service",
    edition = "2024",
    deps = [
        ":lib",
        ":vsock_service_config",
        "//sdk/fidl/fuchsia.hardware.vsock:fuchsia.hardware.vsock_rust",
        "//sdk/fidl/fuchsia.vsock:fuchsia.vsock_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_library(
    name = "lib",
    srcs = [
        "src/addr.rs",
        "src/lib.rs",
        "src/port.rs",
        "src/service.rs",
    ],
    crate_name = "vsock_service_lib",
    edition = "2024",
    visibility = ["//src/developer/remote-control/usb/usb-vsock-service:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.vsock:fuchsia.hardware.vsock_rust",
        "//sdk/fidl/fuchsia.vsock:fuchsia.vsock_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "vsock_service",
)

fx_component(
    name = "vsock_service_component",
    compiled_manifest = ":manifest",
    component_name = "vsock_service",
    visibility = ["//src/paravirtualization/testing:__pkg__"],
    deps = [":bin_packaged_bin"],
)

rustc_test(
    name = "vsock_service_lib_lib_test",
    crate = ":lib",
    deps = ["//src/lib/fuchsia"],
)

fx_unittest_package(
    name = "vsock_service-tests",
    unit_tests = [":vsock_service_lib_lib_test"],
)
