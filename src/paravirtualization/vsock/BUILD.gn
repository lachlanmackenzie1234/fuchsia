  ]
  deps = [ ":bin" ]
}

rustc_test("vsock_service_lib_lib_test") {
  sources = [
    "src/addr.rs",
    "src/lib.rs",
    "src/port.rs",
    "src/service.rs",
  ]
  edition = "2024"
  deps = [
           "//sdk/fidl/fuchsia.hardware.vsock:fuchsia.hardware.vsock_rust",
           "//sdk/fidl/fuchsia.vsock:fuchsia.vsock_rust",
           "//sdk/rust/zx",
