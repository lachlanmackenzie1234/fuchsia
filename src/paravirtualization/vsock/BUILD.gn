}

rustc_library("lib") {
  sources = [
    "src/addr.rs",
    "src/lib.rs",
    "src/port.rs",
    "src/service.rs",
  ]
  crate_name = "vsock_service_lib"
  edition = "2024"
  visibility = [
    ":*",
    "//src/developer/remote-control/usb/usb-vsock-service:*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.vsock:fuchsia.hardware.vsock_rust",
    "//sdk/fidl/fuchsia.vsock:fuchsia.vsock_rust",
    "//sdk/rust/zx",
