import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/paravirtualization:target_tests" ]
}

group("tests") {
  testonly = true

  deps = [
    ":bazel_tests",
    "lib:tests",
    "vsock:tests",
    "vsock-loopback:tests",
  ]
}
