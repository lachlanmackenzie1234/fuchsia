{
    include: [ "//src/proc/tests/starnix_test.shard.cml" ],
    program: {
        environ: [
            "XDG_RUNTIME_DIR=/data/tmp",
            "VIRTWL_DEVICE=/data/tmp/wayland-1",
        ],

        // Kernel config.
        apex_hack: [ "com.android.runtime" ],
        features: [ "binder" ],
        init: [],
        init_user: "root:x:0:0",
        kernel_cmdline: "androidboot.hardware=starnix",
        mounts: [
            "/:ext4:data/system.img",
            "/data:remotefs:data",
            "/data/tmp:tmpfs",
            "/dev:devtmpfs",
            "/proc:proc",
        ],
        name: "wayland_test",
        startup_file_path: "",
    },
}
