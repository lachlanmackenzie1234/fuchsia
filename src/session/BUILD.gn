import("//build/bazel/bazel_test_suite.gni")

group("session") {
  deps = [
    "//src/session/bin",
    "//src/session/lib",
    "//src/session/tools",
  ]
}

group("examples") {
  testonly = true

  deps = [ "//src/session/examples" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/session:target_tests" ]
}

group("tests") {
  testonly = true

  deps = [
    ":bazel_tests",
    ":examples",
    "//src/session/bin:tests",
    "//src/session/examples:tests",
    "//src/session/lib:tests",
    "//src/session/tests",
    "//src/session/tools:tests",
  ]
}
