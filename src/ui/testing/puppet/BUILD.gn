import("//build/components.gni")

# TODO(https://fxbug.dev/543568916): Keep fuchsia_package in GN while
# //src/ui/tests/conformance_input_tests remains in GN.
fuchsia_package("ui-puppet") {
  testonly = true
  deps = [ ":ui-puppet-component" ]
}

