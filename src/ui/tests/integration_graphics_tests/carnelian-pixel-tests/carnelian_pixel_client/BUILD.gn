import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("static_square_bin") {
  sources = [ "src/main.rs" ]
  edition = "2024"
  deps = [
    "//src/lib/ui/carnelian",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:euclid",
  ]
}

fuchsia_component_manifest("static_square_component_manifest") {
  testonly = true
  component_name = "static_square"
  manifest = "meta/static_square.cml"
}

fuchsia_component("static_square_component") {
  testonly = true
  cm_label = ":static_square_component_manifest"
  visibility = [
    ":*",
    "//src/ui/tests/integration_graphics_tests/carnelian-pixel-tests/*",
  ]
  deps = [ ":static_square_bin" ]
}
