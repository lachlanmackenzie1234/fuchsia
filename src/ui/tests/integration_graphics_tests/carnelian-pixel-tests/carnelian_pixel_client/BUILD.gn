import("//build/components.gni")

# TODO(https://fxbug.dev/543568916): Migrate fuchsia_package("package") once
# carnelian-pixel-tests moves to Bazel.
fuchsia_package("package") {
  testonly = true
  package_name = "static_square"
  deps = [ ":static_square_component" ]
}

