load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "util",
    srcs = [
        "boot_info_manager.cc",
        "util.cc",
    ],
    hdrs = [
        "boot_info_manager.h",
        "util.h",
    ],
    # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
    copts = ["-Wno-conversion"],
    implementation_deps = [
        "//sdk/lib/syslog/cpp",
    ],
    visibility = ["//src/ui/a11y:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_hlcpp",
        "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_hlcpp",
        "//sdk/lib/sys/cpp",
        "//src/lib/fsl",
    ],
    alwayslink = True,
)
