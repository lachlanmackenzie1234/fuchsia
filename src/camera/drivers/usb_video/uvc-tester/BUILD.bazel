load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

# `fx_cc_binary` has no `output_name` attribute in Bazel (`fx_packaged_binary`
# sets `binary_name` instead), so pass `output_name` to GN directly.
# @bazel2gn:raw_attribute:output_name = "uvc-tester"
fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    tags = ["manual"],
    visibility = ["//build/cpp:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.camera:fuchsia.camera_hlcpp",
        "//sdk/fidl/fuchsia.hardware.camera:fuchsia.hardware.camera_cpp",
        "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//sdk/lib/async",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-default",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/device-watcher/cpp",
        "//sdk/lib/inspect/component/cpp",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//zircon/system/ulib/zircon-internal",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "uvc-tester",
)

fx_component_manifest(
    name = "component-manifest",
    component_name = "uvc_tester",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/uvc_tester.cml",
)

fx_component(
    name = "component",
    compiled_manifest = ":component-manifest",
    deps = [":bin_packaged_bin"],
)
