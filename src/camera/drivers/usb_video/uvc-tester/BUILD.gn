import("//build/components.gni")

# TODO(https://fxbug.dev/543568916): Migrate group("uvc-tester") and
# fuchsia_package("package") once GN camera callers move to Bazel.
group("uvc-tester") {
  testonly = true
  deps = [ ":package" ]
}

fuchsia_package("package") {
  package_name = "uvc-tester"
  deps = [ ":component" ]
}

