import("//build/dist/resource.gni")

resource("starnix.profiles") {
  sources = [ "starnix.profiles" ]
  outputs = "config/profiles/starnix.profiles"
}

# Add lints here which should apply to all Starnix Rust targets, including
# tests.
config("starnix_clippy_lints_test") {
  rustflags = [ "-Wclippy::wildcard_imports" ]

  # TODO(https://fxbug.dev/447627502): Include me unconditionally.
  if (current_cpu != "riscv64") {
    rustflags += [ "-Wclippy::undocumented_unsafe_blocks" ]
  }
}

# Add lints here which should apply to non-test Starnix Rust targets.
config("starnix_clippy_lints") {
  configs = [ ":starnix_clippy_lints_test" ]
  inputs = [ "clippy.toml" ]
  rustenv = [ "CLIPPY_CONF_DIR=" +
              rebase_path("//src/starnix/config", root_build_dir) ]
  rustflags = [ "-Wclippy::disallowed_types" ]
}
