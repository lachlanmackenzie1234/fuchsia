load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "framebuffer",
    srcs = [
        "lib.rs",
        "server.rs",
    ],
    crate_name = "starnix_modules_framebuffer",
    crate_root = "lib.rs",
    edition = "2024",
    lint_config = "//src/starnix/build:kernel_library_config",
    visibility = ["//src/starnix/modules:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.element:fuchsia.element_rust",
        "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.math:fuchsia.math_rust",
        "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust",
        "//sdk/fidl/fuchsia.ui.composition:fuchsia.ui.composition_rust",
        "//sdk/fidl/fuchsia.ui.display.singleton:fuchsia.ui.display.singleton_rust",
        "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/ui/flatland-frame-scheduling:flatland-frame-scheduling-lib",
        "//src/lib/ui/fuchsia-framebuffer",
        "//src/lib/ui/fuchsia-scenic",
        "//src/starnix/kernel/core",
        "//src/starnix/lib/starnix_lifecycle",
        "//src/starnix/lib/starnix_logging",
        "//src/starnix/lib/starnix_sync",
        "//src/starnix/lib/starnix_syscalls",
        "//src/starnix/lib/starnix_uapi",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "framebuffer_test",
    crate = ":framebuffer",
    # Needed so bazel2gn sets output_name to match program.binary in
    # meta/starnix_framebuffer_tests.cml.
    crate_name = "starnix_modules_framebuffer_lib_test",
    lint_config = "//src/starnix/config:starnix_clippy_lints_test",
    # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
    tags = [
        "exclude_toolchain_tags=asan",
        "exclude_toolchain_tags=hwasan",
    ],
    deps = ["//src/lib/fuchsia"],
)

fx_packaged_binary(
    name = "framebuffer_test_packaged_bin",
    testonly = True,
    binary = ":framebuffer_test",
    binary_name = "starnix_modules_framebuffer_lib_test",
)

fx_component_manifest(
    name = "starnix-framebuffer-tests-manifest",
    testonly = True,
    component_name = "starnix-framebuffer-tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/starnix:unit_test.shard.cml",
    ],
    manifest = "meta/starnix_framebuffer_tests.cml",
)

fx_test_component(
    name = "starnix-framebuffer-tests-component",
    compiled_manifest = ":starnix-framebuffer-tests-manifest",
    deps = [
        ":framebuffer_test_packaged_bin",
        # In GN, //src/starnix/kernel/vdso is a resource() propagated through
        # //src/starnix/kernel/core's deps.
        "//src/starnix/kernel/vdso",
    ],
)

fx_package(
    name = "starnix-framebuffer-tests-package",
    package_name = "starnix-framebuffer-tests",
    test_components = [":starnix-framebuffer-tests-component"],
)

fx_test(
    name = "starnix-framebuffer-tests",
    max_log_severity = "ERROR",
    package = ":starnix-framebuffer-tests-package",
    test_type = "starnix",
)
