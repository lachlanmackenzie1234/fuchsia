fuchsia_component_manifest("starnix-framebuffer-tests-manifest") {
  testonly = true
  component_name = "starnix-framebuffer-tests"
  manifest = "meta/starnix_framebuffer_tests.cml"
}

fuchsia_test_component("starnix-framebuffer-tests-component") {
  cm_label = ":starnix-framebuffer-tests-manifest"
  deps = [
    ":framebuffer_test",
    "//src/starnix/kernel/vdso",
  ]
  test_type = "starnix"
}

fuchsia_test_package("starnix-framebuffer-tests-package") {
  package_name = "starnix-framebuffer-tests-gn"
  test_components = [ ":starnix-framebuffer-tests-component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
