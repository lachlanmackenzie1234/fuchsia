import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/starnix/modules/erofs:starnix-erofs-tests" ]
}

fuchsia_unittest_package("starnix-erofs-tests-package") {
  package_name = "starnix-erofs-tests-gn"
  component_name = "starnix-erofs-tests"
  manifest = "meta/starnix_erofs_tests.cml"
  deps = [
    ":erofs_test",
    "//src/storage/erofs/testing:simple_erofs_image",
    "//src/storage/erofs/testing:simple_raw_files",
  ]
  test_type = "starnix"
  test_specs = {
    create_no_exception_channel = true
  }
}

group("tests") {
  testonly = true
  deps = [ ":starnix-erofs-tests-package" ]

  # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
  # The GN copy's test binary is excluded from asan/hwasan variants with
  # exclude_toolchain_tags, which Bazel ignores.
  if (!is_asan) {
    deps += [ ":bazel_tests" ]
  }
}

