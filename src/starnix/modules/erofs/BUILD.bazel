load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "erofs",
    srcs = ["lib.rs"],
    crate_name = "starnix_modules_erofs",
    crate_root = "lib.rs",
    edition = "2024",
    lint_config = "//src/starnix/build:kernel_library_config",
    visibility = ["//src/starnix/modules:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.erofs:fuchsia.erofs_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/starnix/kernel/core",
        "//src/starnix/lib/starnix_logging",
        "//src/starnix/lib/starnix_sync",
        "//src/starnix/lib/starnix_types",
        "//src/starnix/lib/starnix_uapi",
        "//src/storage/erofs",
        "//src/storage/fidl/fuchsia.storage.mapping:fuchsia.storage.mapping_rust",
    ],
)

rustc_test(
    name = "erofs_test",
    crate = ":erofs",
    # Sets GN output_name to match bin/starnix_modules_erofs_lib_test in
    # meta/starnix_erofs_tests.cml.
    crate_name = "starnix_modules_erofs_lib_test",
    lint_config = "//src/starnix/config:starnix_clippy_lints_test",
    # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
    tags = [
        "exclude_toolchain_tags=asan",
        "exclude_toolchain_tags=hwasan",
    ],
    deps = [
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "erofs_test_packaged_bin",
    testonly = True,
    binary = ":erofs_test",
    binary_name = "starnix_modules_erofs_lib_test",
)

fx_component_manifest(
    name = "starnix-erofs-tests-manifest",
    testonly = True,
    component_name = "starnix-erofs-tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/starnix:unit_test.shard.cml",
    ],
    manifest = "meta/starnix_erofs_tests.cml",
)

fx_test_component(
    name = "starnix-erofs-tests-component",
    compiled_manifest = ":starnix-erofs-tests-manifest",
    test_type = "starnix",
    deps = [
        ":erofs_test_packaged_bin",
        # In GN, //src/starnix/kernel/vdso is a resource() propagated through
        # //src/starnix/kernel/core's deps.
        "//src/starnix/kernel/vdso",
        "//src/storage/erofs/testing:simple_erofs_image",
        "//src/storage/erofs/testing:simple_raw_files",
    ],
)

# Hand-maintained in BUILD.gn above the sentinel because bazel2gn does not
# support create_no_exception_channel on fx_test.
# @bazel2gn:skip
fx_package(
    name = "starnix-erofs-tests-package",
    package_name = "starnix-erofs-tests",
    test_components = [":starnix-erofs-tests-component"],
)

fx_test(
    name = "starnix-erofs-tests",
    create_no_exception_channel = True,
    package = ":starnix-erofs-tests-package",
    test_type = "starnix",
)
