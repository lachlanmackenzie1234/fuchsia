load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load(
    "//build/bazel/rules/packages:fx_package.bzl",
    "fx_package",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

exports_files(
    ["meta/fastrpc.core_shard.cml"],
    visibility = ["//bundles/assembly:__subpackages__"],
)

fx_package(
    name = "google_fastrpc",
    package_name = "google_fastrpc",
    components = [
        ":google_fastrpc_component",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

# Consumed only by the Bazel-only google_fastrpc package.
# @bazel2gn:skip
fx_component(
    name = "google_fastrpc_component",
    compiled_manifest = ":google_fastrpc_manifest",
)

fx_component_manifest(
    name = "google_fastrpc_manifest",
    component_name = "google_fastrpc",
    includes = [
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/fastrpc.cml",
)

rustc_library(
    name = "fastrpc",
    srcs = [
        "dma_heap.rs",
        "fastrpc.rs",
        "lib.rs",
    ],
    crate_name = "starnix_modules_fastrpc",
    crate_root = "lib.rs",
    edition = "2024",
    lint_config = "//src/starnix/build:kernel_library_config",
    visibility = ["//src/starnix/modules:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.qualcomm.fastrpc:fuchsia.hardware.qualcomm.fastrpc_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-component",
        "//src/starnix/kernel/core",
        "//src/starnix/lib/linux_uapi",
        "//src/starnix/lib/starnix_logging",
        "//src/starnix/lib/starnix_sync",
        "//src/starnix/lib/starnix_syscalls",
        "//src/starnix/lib/starnix_types",
        "//src/starnix/lib/starnix_uapi",
        "//third_party/rust_crates/vendor:bitfield",
        "//third_party/rust_crates/vendor:bstr",
    ],
)

rustc_test(
    name = "fastrpc_test",
    crate = ":fastrpc",
    # Matches program.binary in meta/starnix_fastrpc_tests.cml for the generated GN test.
    crate_name = "starnix_modules_fastrpc_lib_test",
    lint_config = "//src/starnix/config:starnix_clippy_lints_test",
    # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
    tags = [
        "exclude_toolchain_tags=asan",
        "exclude_toolchain_tags=hwasan",
    ],
    deps = [
        "//src/lib/fuchsia",
    ],
)

fx_packaged_binary(
    name = "fastrpc_test_packaged_bin",
    testonly = True,
    binary = ":fastrpc_test",
    binary_name = "starnix_modules_fastrpc_lib_test",
)

fx_component_manifest(
    name = "starnix-fastrpc-tests-manifest",
    testonly = True,
    component_name = "starnix-fastrpc-tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/starnix:unit_test.shard.cml",
    ],
    manifest = "meta/starnix_fastrpc_tests.cml",
)

fx_test_component(
    name = "starnix-fastrpc-tests-component",
    compiled_manifest = ":starnix-fastrpc-tests-manifest",
    test_type = "starnix",
    deps = [
        ":fastrpc_test_packaged_bin",
        # In GN, //src/starnix/kernel/vdso is a resource() propagated through
        # //src/starnix/kernel/core's deps.
        "//src/starnix/kernel/vdso",
    ],
)

# bazel2gn does not translate fx_test(create_no_exception_channel = True);
# the GN copy is hand-written in BUILD.gn.
# @bazel2gn:skip
fx_package(
    name = "starnix-fastrpc-tests-package",
    package_name = "starnix-fastrpc-tests",
    test_components = [":starnix-fastrpc-tests-component"],
)

fx_test(
    name = "starnix-fastrpc-tests",
    create_no_exception_channel = True,
    package = ":starnix-fastrpc-tests-package",
    test_type = "starnix",
)
