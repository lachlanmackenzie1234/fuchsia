import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/dist/resource.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/starnix/modules/loop:starnix-loop-tests" ]
}

group("tests") {
  testonly = true
  deps = [ ":starnix-loop-tests" ]

  # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
  if (!is_asan) {
    deps += [ ":bazel_tests" ]
  }
}

# LINT.IfChange
resource("test_files") {
  sources = [
    "test_data/testfile.txt",
    "test_data/testfile2.txt",
  ]
  outputs = [ "data/{{source_file_part}}" ]
}

# LINT.ThenChange(BUILD.bazel)

# GN copy of the Bazel `starnix-loop-tests` package, written by hand because
# bazel2gn does not support `create_no_exception_channel` on `fx_test`.
fuchsia_unittest_package("starnix-loop-tests") {
  package_name = "starnix-loop-tests-gn"
  component_name = "starnix-loop-tests"
  manifest = "meta/starnix_loop_tests.cml"
  deps = [
    ":starnix_modules_loop_lib_test",
    ":test_files",
  ]
  test_type = "starnix"
  test_specs = {
    create_no_exception_channel = true
  }
}

