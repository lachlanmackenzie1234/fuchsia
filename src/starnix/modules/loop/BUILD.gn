import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("loop") {
  sources = [ "lib.rs" ]
  crate_name = "starnix_modules_loop"
  source_root = "lib.rs"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  visibility = [
    ":*",
    "//src/starnix/modules/*",
  ]
  deps = [
    "//sdk/rust/zx",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_ext",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_syscalls",
    "//src/starnix/lib/starnix_types",
    "//src/starnix/lib/starnix_uapi",
    "//third_party/rust_crates:bitflags",
  ]
  if (is_lto_variant || optimize == "size_lto" || optimize == "size_thinlto") {
    _concurrent_jobs = concurrent_jobs.link_highmem
    configs += _concurrent_jobs.configs
    forward_variables_from(_concurrent_jobs.vars, "*")
  }
}

rustc_test("starnix_modules_loop_lib_test") {
  sources = [ "lib.rs" ]
  source_root = "lib.rs"
  edition = "2024"
  deps = [
           "//sdk/rust/zx",
           "//src/starnix/kernel/core",
           "//src/starnix/lib/starnix_ext",
           "//src/starnix/lib/starnix_logging",
           "//src/starnix/lib/starnix_sync",
           "//src/starnix/lib/starnix_syscalls",
           "//src/starnix/lib/starnix_types",
           "//src/starnix/lib/starnix_uapi",
           "//third_party/rust_crates:bitflags",
         ] +
         [
           "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
           "//src/lib/fidl/rust/fidl",
           "//src/lib/fuchsia",
           "//src/lib/fuchsia-fs",
         ]
  lint_config = "//src/starnix/config:starnix_clippy_lints_test"
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
}
