import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("android_usb") {
  sources = [ "lib.rs" ]
  crate_name = "starnix_modules_android_usb"
  source_root = "lib.rs"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  visibility = [
    ":*",
    "//src/starnix/modules/*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.usb.policy:fuchsia.hardware.usb.policy_rust",
    "//sdk/fidl/fuchsia.usb.policy:fuchsia.usb.policy_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia-component",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_uapi",
  ]
}

rustc_test("android_usb_test") {
  sources = [ "lib.rs" ]
  source_root = "lib.rs"
  edition = "2024"
  deps = [
           "//sdk/fidl/fuchsia.hardware.usb.policy:fuchsia.hardware.usb.policy_rust",
           "//sdk/fidl/fuchsia.usb.policy:fuchsia.usb.policy_rust",
           "//sdk/rust/zx",
           "//src/lib/fuchsia-component",
           "//src/starnix/kernel/core",
           "//src/starnix/lib/starnix_logging",
           "//src/starnix/lib/starnix_sync",
           "//src/starnix/lib/starnix_uapi",
         ] +
         [
           "//src/lib/fidl/rust/fidl",
           "//src/lib/fuchsia",
           "//src/lib/fuchsia-async",
           "//src/starnix/lib/starnix_rcu",
           "//third_party/rust_crates:futures",
         ]
  output_name = "starnix_modules_android_usb_lib_test"
  lint_config = "//src/starnix/config:starnix_clippy_lints_test"
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
}

fuchsia_component_manifest("starnix-android-usb-tests-manifest") {
  testonly = true
  component_name = "starnix-android-usb-tests"
  manifest = "meta/starnix_android_usb_tests.cml"
}

fuchsia_test_component("starnix-android-usb-tests-component") {
  cm_label = ":starnix-android-usb-tests-manifest"
  test_type = "starnix"
  deps = [
    ":android_usb_test",
    "//src/starnix/kernel/vdso",
  ]
}

fuchsia_test_package("starnix-android-usb-tests-package") {
  package_name = "starnix-android-usb-tests-gn"
  test_components = [ ":starnix-android-usb-tests-component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
