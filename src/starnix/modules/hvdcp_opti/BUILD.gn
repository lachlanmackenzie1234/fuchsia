    "//third_party/rust_crates:futures-util",
    "//third_party/rust_crates:zerocopy",
  ]
}

rustc_test("hvdcp_opti_module_test") {
  sources = [
    "device.rs",
    "iio_file.rs",
    "lib.rs",
    "qbg_battery_file.rs",
    "qbg_file.rs",
    "utils.rs",
  ]
  source_root = "lib.rs"
  edition = "2024"
  deps = [
           "//sdk/fidl/fuchsia.hardware.qcom.hvdcpopti:fuchsia.hardware.qcom.hvdcpopti_rust",
           "//sdk/fidl/fuchsia.power.system:fuchsia.power.system_rust",
           "//sdk/rust/zx",
           "//src/lib/fidl/rust/fidl",
           "//src/starnix/kernel/core",
           "//src/starnix/lib/starnix_logging",
           "//src/starnix/lib/starnix_sync",
           "//src/starnix/lib/starnix_syscalls",
           "//src/starnix/lib/starnix_uapi",
           "//third_party/rust_crates:futures",
           "//third_party/rust_crates:futures-util",
           "//third_party/rust_crates:zerocopy",
         ] + [ "//src/lib/fuchsia" ]
  output_name = "starnix_modules_hvdcp_opti_lib_test"
  lint_config = "//src/starnix/config:starnix_clippy_lints_test"
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
}

fuchsia_component_manifest("starnix-hvdcp-opti-tests-manifest") {
  testonly = true
  component_name = "starnix-hvdcp-opti-tests"
  manifest = "meta/starnix_hvdcp_opti_tests.cml"
}

fuchsia_test_component("starnix-hvdcp-opti-tests-component") {
  cm_label = ":starnix-hvdcp-opti-tests-manifest"
  test_type = "starnix"
  deps = [
    ":hvdcp_opti_module_test",
    "//src/starnix/kernel/vdso",
  ]
}

fuchsia_test_package("starnix-hvdcp-opti-tests-package") {
  package_name = "starnix-hvdcp-opti-tests-gn"
  test_components = [ ":starnix-hvdcp-opti-tests-component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
