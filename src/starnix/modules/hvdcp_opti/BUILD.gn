    "//src/starnix/modules/*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.qcom.hvdcpopti:fuchsia.hardware.qcom.hvdcpopti_rust",
    "//sdk/fidl/fuchsia.power.system:fuchsia.power.system_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/starnix/kernel/core",
