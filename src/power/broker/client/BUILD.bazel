load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

# @bazel2gn:skip
test_suite(
    name = "tests",
    tests = [":power_broker_client_lib_unittests"],
    visibility = ["//src/power:__pkg__"],
)

rustc_library(
    name = "client",
    srcs = ["src/lib.rs"],
    crate_name = "power_broker_client",
    edition = "2024",
    visibility = [
        "//src/power/broker:__subpackages__",
        "//src/power/system-activity-governor:__subpackages__",
        "//src/session/bin/session_manager:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

# Needs reviewer attention (bazel2gn skip): Keeping the dual-built GN fuchsia_unittest_package wired alongside bazel_test_suite fails core.x64-asan testsharder ("some shard names are repeated: affected:AEMU") when use_test_pilot = true sets os = "linux" on the GN test; TODO(https://fxbug.dev/570694755).
# @bazel2gn:skip
rustc_test(
    name = "power_broker_client_lib_test",
    crate = ":client",
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
    ],
)

# Needs reviewer attention (bazel2gn skip): Keeping the dual-built GN fuchsia_unittest_package wired alongside bazel_test_suite fails core.x64-asan testsharder ("some shard names are repeated: affected:AEMU") when use_test_pilot = true sets os = "linux" on the GN test; TODO(https://fxbug.dev/570694755).
# @bazel2gn:skip
fx_unittest_package(
    name = "power_broker_client_lib_unittests",
    unit_tests = [":power_broker_client_lib_test"],
)
