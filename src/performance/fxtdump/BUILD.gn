import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("fxtdump") {
    bazel_target = ":bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/bin"
    install_host_tool = true
  }
} else {
  group("fxtdump") {
    public_deps = [ ":fxtdump($host_toolchain)" ]
  }
}
