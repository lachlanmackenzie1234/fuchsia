load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "radarutil-bin",
    srcs = [
        "main.cc",
        "radarutil.cc",
        "radarutil.h",
    ],
    # GN sets -D_ALL_SOURCE via the //build/config:all_source config.
    copts = [
        "-D_ALL_SOURCE",
    ],  # @bazel2gn:raw_overwrite:[ "//build/config:all_source" ]
    gn_output_name = "radarutil",
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.radar:fuchsia.hardware.radar_cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/component/incoming/cpp",
        "//zircon/system/ulib/fbl",
    ],
)

fx_packaged_binary(
    name = "radarutil_packaged_bin",
    binary = ":radarutil-bin",
    binary_name = "radarutil",
)

fx_package(
    name = "radarutil",
    package_name = "radarutil",
    resources = [":radarutil_packaged_bin"],
)

fx_component_manifest(
    name = "radarutil-component-manifest",
    component_name = "radarutil-component",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/radarutil.cml",
)

fx_component(
    name = "radarutil-component",
    compiled_manifest = ":radarutil-component-manifest",
    deps = [":radarutil_packaged_bin"],
)

fx_cc_test_binary(
    name = "radarutil-test-bin",
    srcs = [
        "radarutil.cc",
        "radarutil.h",
        "radarutil-test.cc",
    ],
    # GN sets -D_ALL_SOURCE via the //build/config:all_source config.
    copts = [
        "-D_ALL_SOURCE",
    ],  # @bazel2gn:raw_overwrite:[ "//build/config:all_source" ]
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.radar:fuchsia.hardware.radar_cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/component/incoming/cpp",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "radarutil-test",
    unit_tests = [":radarutil-test-bin"],
    visibility = ["//src/devices:__pkg__"],
)
