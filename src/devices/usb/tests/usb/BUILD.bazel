load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")

package(default_applicable_licenses = ["//:license"])

# GN's bootfs_test() expects the binary at test/usb-test via distribution_entries metadata, which cc_test_executable() omits.
# @bazel2gn:raw_attribute:metadata = { distribution_entries = [ { source = rebase_path("$root_out_dir/usb-test", root_build_dir) destination = "test/usb-test" label = get_label_info(":usb", "label_with_toolchain") } ] }
fx_cc_test_binary(
    name = "usb",
    srcs = ["usb-test.cc"],
    gn_output_name = "usb-test",
    deps = [
        "//sdk/fidl/fuchsia.hardware.usb.tester:fuchsia.hardware.usb.tester_cpp",
        "//sdk/lib/component/incoming/cpp",
        "//zircon/system/ulib/zxtest",
    ],
)
