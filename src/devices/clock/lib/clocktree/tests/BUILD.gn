    "//sdk/lib/fdio",
    "//src/devices/clock/lib/clocktree",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("clocktree_test") {
  package_name = "clocktree_test-gn"
  component_name = "clocktree_test"
  deps = [ ":test" ]
  visibility = [
    ":*",
    "//src/devices:*",
    "//src/devices/clock/lib:*",
  ]
}
