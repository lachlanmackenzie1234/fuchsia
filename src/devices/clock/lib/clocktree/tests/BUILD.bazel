load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_test_binary(
    name = "test",
    srcs = [
        "clocktree-test.cc",
        "testclock.cc",
        "testclock.h",
    ],
    # clocktree headers are under ../include; GN sets include_dirs via :include.
    copts = [
        "-Isrc/devices/clock/lib/clocktree/include",
    ],  # @bazel2gn:raw_overwrite:[ ":include" ]
    gn_output_name = "clocktree_test",
    tags = ["manual"],
    deps = [
        "//sdk/lib/fdio",
        "//src/devices/clock/lib/clocktree",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "clocktree_test",
    unit_tests = [":test"],
    visibility = [
        "//src/devices:__pkg__",
        "//src/devices/clock/lib:__pkg__",
    ],
)
