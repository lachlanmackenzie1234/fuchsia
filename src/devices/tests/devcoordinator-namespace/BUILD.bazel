load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")

package(default_applicable_licenses = ["//:license"])

# GN's bootfs_test() expects the binary at test/devcoordinator-namespace-test via distribution_entries metadata, which cc_test_executable() omits.
# @bazel2gn:raw_attribute:metadata = { distribution_entries = [ { source = rebase_path("$root_out_dir/devcoordinator-namespace-test", root_build_dir) destination = "test/devcoordinator-namespace-test" label = get_label_info(":devcoordinator-namespace", "label_with_toolchain") } ] }
fx_cc_test_binary(
    name = "devcoordinator-namespace",
    srcs = ["namespace_test.cc"],
    gn_output_name = "devcoordinator-namespace-test",
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zxtest",
    ],
)
