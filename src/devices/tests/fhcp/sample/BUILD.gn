import("//build/tools/bazel2gn/bazel_migration.gni")

cc_test_executable("sample-test-bin") {
  sources = [ "sample-test.cc" ]
  output_name = "fhcp-sample-test"
  deps = [ "//zircon/system/ulib/zxtest" ]
  testonly = true
  emit_tool_path = false
  if (is_fuchsia) {
    metadata = {
      distribution_entries = [
        {
          source = rebase_path("$root_out_dir/fhcp-sample-test", root_build_dir)
          destination = "test/fhcp-sample-test"
          label = get_label_info(":sample-test-bin", "label_with_toolchain")
        },
      ]
    }
  }
}
