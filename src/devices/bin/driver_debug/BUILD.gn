import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

fuchsia_package("driver_debug") {
  deps = [ ":debug" ]
}

group("bootfs") {
  deps = [ ":debug" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/devices/bin/driver_debug:driver_debug_unit_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "tests",
  ]
}

