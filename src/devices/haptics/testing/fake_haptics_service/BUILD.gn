import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "fake_haptics_service"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.haptics:fuchsia.hardware.haptics_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component_manifest("manifest") {
  component_name = "fake_haptics_service"
  manifest = "meta/fake_haptics_service.cml"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}
