load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.media.audio:fuchsia.media.audio_hlcpp",
        "//sdk/lib/sys/cpp",
        "//src/lib/fxl:fxl_cli",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "audio-effects-ctl",
)

fx_package(
    name = "audio-effects-ctl",
    package_name = "audio-effects-ctl",
    package_repository_name = "fuchsia.com",
    resources = [":bin_packaged"],
    visibility = ["//bundles/assembly:__subpackages__"],
)
