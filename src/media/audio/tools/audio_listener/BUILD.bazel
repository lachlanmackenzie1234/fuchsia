load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    srcs = [
        "audio_listener.cc",
        "audio_listener.h",
        "escape_decoder.h",
    ],
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.media:fuchsia.media_hlcpp",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/fit",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fsl",
        "//src/lib/fxl:fxl_cli",
        "//src/media/audio/lib/logging:cli",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "audio_listener",
)

fx_package(
    name = "audio_listener",
    package_name = "audio_listener",
    package_repository_name = "fuchsia.com",
    resources = [":bin_packaged"],
    visibility = ["//bundles/assembly:__subpackages__"],
)
