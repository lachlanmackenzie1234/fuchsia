load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")

package(default_applicable_licenses = ["//:license"])

# fx_cc_binary does not support output_name in Bazel.
# @bazel2gn:raw_attribute:output_name = "simple_adr"
fx_cc_binary(
    name = "bin",
    srcs = [
        "simple_adr.cc",
        "simple_adr.h",
    ],
    # TODO(https://fxbug.dev/543568916): simple_adr.cc uses angled #include
    # <src/lib/fxl/strings/string_printf.h>, which GN resolves via its root -I
    # flag while Bazel only adds -iquote .
    # @bazel2gn:skip
    copts = ["-I."],
    deps = [
        "//sdk/fidl/fuchsia.audio.device:fuchsia.audio.device_cpp",
        "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_cpp",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/fit",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fxl",
        "//zircon/system/ulib/fzl",
        "//zircon/system/ulib/zx",
    ],
)
