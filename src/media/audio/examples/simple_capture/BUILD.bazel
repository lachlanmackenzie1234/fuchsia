load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")

package(default_applicable_licenses = ["//:license"])

# fx_cc_binary does not support output_name in Bazel.
# @bazel2gn:raw_attribute:output_name = "simple_capture"
fx_cc_binary(
    name = "bin",
    srcs = [
        "simple_capture.cc",
        "simple_capture.h",
    ],
    deps = [
        "//sdk/fidl/fuchsia.media:fuchsia.media_hlcpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/media/audio/cpp",
        "//sdk/lib/sys/cpp",
        "//src/media/audio/lib/logging:cli",
        "//src/media/audio/lib/wav",
        "//zircon/system/ulib/fzl",
    ],
)
