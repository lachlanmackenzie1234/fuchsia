load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_test_binary(
    name = "range",
    srcs = [
        "interval-tree-test.cc",
        "range.cc",
    ],
    deps = [
        "//sdk/lib/fdio",
        "//src/storage/lib/range",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "range-test-pkg",
    package_name = "range",
    unit_tests = [":range"],
    visibility = ["//src/storage:__pkg__"],
)
