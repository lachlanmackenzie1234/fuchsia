load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "mock",
    edition = "2024",
    # TODO(https://fxbug.dev/570694755): GN `rustc_binary` uses
    # `clippy_warn_default` when `testonly = true`, while Bazel defaults to
    # `clippy_warn_production`.
    # @bazel2gn:skip
    lint_config = "//build/config/rust/lints:clippy_warn_default",
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.hwinfo:fuchsia.hwinfo_rust",
        "//src/hwinfo/mock/fidl:fuchsia.hwinfo.mock_rust",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "mock_packaged_bin",
    testonly = True,
    binary = ":bin",
    binary_name = "mock",
)

fx_component_manifest(
    name = "component_manifest",
    testonly = True,
    component_name = "mock",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/mock.cml",
)

fx_component(
    name = "component",
    testonly = True,
    compiled_manifest = ":component_manifest",
    component_name = "mock",
    deps = [":mock_packaged_bin"],
)

fx_package(
    name = "package",
    package_name = "hwinfo-mock",
    testonly = True,
    components = [":component"],
)
