load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "package-manager-sample-bin",
    testonly = True,
    srcs = ["hello_world.cc"],
    tags = ["manual"],
    deps = ["//sdk/lib/syslog/cpp"],
)

fx_cc_binary(
    name = "package-manager-sample-bin2",
    testonly = True,
    srcs = ["hello_world2.cc"],
    tags = ["manual"],
    deps = ["//sdk/lib/syslog/cpp"],
)

fx_packaged_binary(
    name = "package-manager-sample-bin_packaged_bin",
    testonly = True,
    binary = ":package-manager-sample-bin",
    binary_name = "package-manager-sample-bin",
)

fx_packaged_binary(
    name = "package-manager-sample-bin2_packaged_bin",
    testonly = True,
    binary = ":package-manager-sample-bin2",
    binary_name = "package-manager-sample-bin2",
)

fx_component_manifest(
    name = "package-manager-sample-manifest",
    testonly = True,
    component_name = "package-manager-sample",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner.shard.cml",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/package-manager-sample.cml",
)

fx_component_manifest(
    name = "package-manager-sample2-manifest",
    testonly = True,
    component_name = "package-manager-sample2",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner.shard.cml",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/package-manager-sample2.cml",
)

fx_component(
    name = "package-manager-sample",
    testonly = True,
    compiled_manifest = ":package-manager-sample-manifest",
    deps = [":package-manager-sample-bin_packaged_bin"],
)

fx_component(
    name = "package-manager-sample2",
    testonly = True,
    compiled_manifest = ":package-manager-sample2-manifest",
    deps = [":package-manager-sample-bin2_packaged_bin"],
)
