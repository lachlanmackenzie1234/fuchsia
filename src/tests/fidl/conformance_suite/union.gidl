decode_success("FlexibleUnionUnknown64BitOrdinal") {
    // TODO(https://fxbug.dev/42166276): Support unknown union variants in remaining GIDL backends.
    bindings_allowlist = [cpp, rust, rust_codec, rust_next],
    value = TestFlexibleXUnionInStruct{
        xu: SampleXUnion{
            0x100000001: null,
        },
    },
    bytes = {
        v2 = [
            num(0x100000001):8, // 64-bit unknown ordinal (> u32::MAX)
            num(8):4, num(0):2, num(0):2, // envelope
            repeat(0xab):8, // unknown bytes
        ],
    },
}
