success("StructOfNonZeroUInt8_one") {
    bindings_allowlist = [cpp, llcpp],
    value = StructOfNonZeroUInt8{
        foo: 1,
    },
    bytes = {
        v2 = [
            num(1):1, padding:7,
        ],
    },
}

encode_failure("StructOfNonZeroUInt8_encode_zero") {
    bindings_allowlist = [cpp, llcpp],
    value = StructOfNonZeroUInt8{
        foo: 0,
    },
    err = INVALID_NON_ZERO,
}

decode_failure("StructOfNonZeroUInt8_decode_zero") {
    bindings_allowlist = [cpp, llcpp],
    type = StructOfNonZeroUInt8,
    bytes = {
        v2 = [
            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // 0 + 7 bytes of padding
        ],
    },
    err = INVALID_NON_ZERO,
}

