success("VectorOfNonZeroInt32_non_zero") {
    bindings_allowlist = [cpp, llcpp],
    value = VectorOfNonZeroInt32{
        foo: [1, 2],
    },
    bytes = {
        v2 = [
            num(2):8, repeat(0xff):8,
            num(1):4, num(2):4,
        ],
    },
}

encode_failure("VectorOfNonZeroInt32_encode_zero") {
    bindings_allowlist = [cpp, llcpp],
    value = VectorOfNonZeroInt32{
        foo: [1, 0],
    },
    err = INVALID_NON_ZERO,
}

decode_failure("VectorOfNonZeroInt32_decode_zero") {
    bindings_allowlist = [cpp, llcpp],
    type = VectorOfNonZeroInt32,
    bytes = {
        v2 = [
            num(2):8, repeat(0xff):8,
            num(1):4, num(0):4,
        ],
    },
    err = INVALID_NON_ZERO,
}
