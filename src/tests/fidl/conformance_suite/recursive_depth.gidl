success("RecursiveTableHolderAtLimit") {
    // Each level of RecursiveTable -> s (out-of-line envelope) -> o (box) adds 3 to
    // out-of-line depth; the final level with o: null adds 2.
    // 10 * 3 + 2 = 32 (at the max out-of-line depth limit).
    // gidl-format off
    value = RecursiveTableHolder{
    t: RecursiveTable{ // depth 1 (table vector), 2 (envelope s)
    s: RecursiveTableOptionalHolder{
    o: RecursiveTableHolder{ // depth 3
    t: RecursiveTable{ // depth 4, 5
