import("//build/tools/bazel2gn/bazel_migration.gni")

executable("bin") {
  sources = [ "crasher.cc" ]
  deps = [
    "//sdk/lib/fdio",
    "//src/zircon/lib/zircon",
  ]
  output_name = "crasher_bin"
}

fuchsia_component_manifest("crasher-manifest") {
  component_name = "crasher"
  manifest = "meta/crasher.cml"
}

fuchsia_component("crasher-component") {
  cm_label = ":crasher-manifest"
  deps = [ ":bin" ]
}
