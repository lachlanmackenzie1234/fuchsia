load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

# `fx_cc_binary` has no `output_name` attribute in Bazel.
# @bazel2gn:raw_attribute:output_name = "crasher_bin"
fx_cc_binary(
    name = "bin",
    srcs = ["crasher.cc"],
    tags = ["manual"],
    deps = [
        "//sdk/lib/fdio",
        "//src/zircon/lib/zircon",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "crasher_bin",
)

fx_component_manifest(
    name = "crasher-manifest",
    component_name = "crasher",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/crasher.cml",
)

fx_component(
    name = "crasher-component",
    compiled_manifest = ":crasher-manifest",
    deps = [":bin_packaged"],
)
