import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_fuchsia) {
  rustc_test("underlying_test_to_be_sharded") {
    sources = [ "src/lib.rs" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:paste" ]
  }
}
if (is_fuchsia) {
  rustc_test("underlying_test_to_be_sharded_with_failures") {
    sources = [ "src/lib.rs" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:paste" ]
    rustflags = [ "--cfg=make_case_f_fail" ]
  }
}
