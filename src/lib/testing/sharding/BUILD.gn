import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/lib/testing/sharding:sharder-test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":sharder-test",
    "tests/example_sharded_test:tests",
    "tests/integration:tests",
  ]
}

