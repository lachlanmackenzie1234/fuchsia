import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  testonly = true
  sources = [ "src/main.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  output_name = "sharder"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:regex",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
  ]
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [ "src/main.rs" ]
    edition = "2024"
    deps = [
      "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-component",
      "//src/lib/fuchsia-fs",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:itertools",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:regex",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
    ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    output_name = "sharder_bin_test"
  }
}

fuchsia_component_manifest("sharder_manifest") {
  testonly = true
  component_name = "sharder"
  manifest = "meta/sharder.cml"
}

fuchsia_component("sharder") {
  testonly = true
  cm_label = ":sharder_manifest"
  visibility = [ "//*" ]
  deps = [ ":bin" ]
}

fuchsia_unittest_package("sharder-test") {
  package_name = "sharder-test-gn"
  component_name = "sharder-test"
  deps = [ ":bin_test" ]
}
