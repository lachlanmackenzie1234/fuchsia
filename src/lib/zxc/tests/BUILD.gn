import("//build/tools/bazel2gn/bazel_migration.gni")

cc_test_executable("zxc_unittests") {
  sources = [ "result_tests.cc" ]
  deps = [
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_component("zxc-tests-component") {
  deps = [ ":zxc_unittests" ]
  component_name = "zxc-tests"
}

fuchsia_test_package("zxc-tests-package") {
  package_name = "zxc-tests-gn"
  test_components = [ ":zxc-tests-component" ]
  test_specs = {
    environments = [ emu_env ]
  }
}
