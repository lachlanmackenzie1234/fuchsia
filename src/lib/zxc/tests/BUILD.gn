import("//build/testing/host_test.gni")

# The GN copy of the `zxc_host_unittests` Bazel host test. bazel2gn doesn't
# translate `host_cc_test()` yet (https://fxbug.dev/574121341), and the
# generated `cc_test_executable("zxc_unittests")` doesn't register a host test
# by itself.
if (is_host) {
  host_test("zxc_unittests_host_test") {
    binary_path = "$root_out_dir/zxc_unittests"
    target = get_label_info(":zxc_unittests", "label_with_toolchain")
    deps = [ ":zxc_unittests" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":zxc-tests-package",
    ":zxc_unittests_host_test($host_toolchain)",
  ]
}

