import("//build/rust/rustc_cdylib.gni")

set_defaults("fuchsia_cc_dso") {
  configs = default_shared_library_configs
}

set_defaults("fuchsia_rust_dso") {
  configs = default_shared_library_configs
}

# TODO(https://fxbug.dev/483772254): Switch these to use loadable_module, like
# drivers

template("fuchsia_cc_dso") {
  assert(defined(invoker.async), "async must be set to true or false")
  if (invoker.async) {
    _dso_deps = [ "//src/lib/dso/cpp:async" ]
  } else {
    _dso_deps = [ "//src/lib/dso/cpp:sync" ]
  }

  shared_library(target_name) {
    forward_variables_from(invoker,
                           [
                             "applicable_licenses",
                             "visibility",
                           ])
    forward_variables_from(invoker,
                           "*",
                           [
                             "applicable_licenses",
                             "async",
                             "visibility",
                           ])
    if (!defined(deps)) {
      deps = []
    }
    deps += _dso_deps
    deps -= _dso_deps
    deps += _dso_deps
  }
}

template("fuchsia_rust_dso") {
  _dso_deps = [
    "//sdk/rust/zx",
    "//src/lib/dso/rust",
    "//src/lib/fuchsia",
  ]

  rustc_cdylib(target_name) {
    forward_variables_from(invoker,
                           [
                             "applicable_licenses",
                             "visibility",
                           ])
    forward_variables_from(invoker,
                           "*",
                           [
                             "applicable_licenses",
                             "visibility",
                           ])
    if (!defined(deps)) {
      deps = []
    }
    deps += _dso_deps
    deps -= _dso_deps
    deps += _dso_deps
  }
}
