load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "rust",
    srcs = ["src/lib.rs"],
    crate_name = "fuchsia_dso",
    edition = "2024",
    proc_macro_deps = ["//src/lib/dso/rust/macro"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/lib/dso:__pkg__",
        "//src/sys/runners/dso:__subpackages__",
        "//src/ui/bin/scene_manager:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//sdk/lib/driver/runtime/rust",
        "//sdk/lib/driver/runtime/rust/fdf_sys",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-runtime",
        "//src/sys/lib/cm_types",
    ],
)
