import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_fuchsia) {
  rustc_library("rust") {
    sources = [ "src/lib.rs" ]
    crate_name = "fuchsia_dso"
    edition = "2024"
    proc_macro_deps = [ "//src/lib/dso/rust/macro" ]
    visibility = [
      ":*",
      "//src/lib/dso:*",
      "//src/sys/runners/dso/*",
      "//src/ui/bin/scene_manager:*",
    ]
    deps = [
      "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
      "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
      "//sdk/lib/driver/runtime/rust",
      "//sdk/lib/driver/runtime/rust/fdf_sys",
      "//sdk/rust/zx",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia-runtime",
      "//src/sys/lib/cm_types",
    ]
  }
}
