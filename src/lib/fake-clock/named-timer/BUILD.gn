import("//build/tools/bazel2gn/bazel_migration.gni")

fidl("fidl") {
  sources = [ "deadline.fidl" ]
  enable_hlcpp = true
  name = "fuchsia.testing.deadline"
  visibility = [
    ":*",
    "//src/lib/fake-clock/fidl:*",
    "//src/lib/fake-clock/svc:*",
  ]
}

rustc_library("named-timer") {
  sources = [ "src/lib.rs" ]
  crate_name = "named_timer"
  edition = "2024"
  link_deps = [ ":named_timer_noop_lib" ]
  visibility = [
    ":*",
    "//src/connectivity/policy/reachability/*",
    "//src/lib/fake-clock/examples/rust:*",
    "//src/lib/fake-clock/svc:*",
    "//src/power/power-manager/*",
  ]
  deps = [
    ":fidl_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia-async",
  ]
}

source_set("named-timer-headers") {
  sources = [ "named_timer.h" ]
  visibility = [
    ":*",
    "//src/lib/fake-clock/lib:*",
  ]
}
if (is_fuchsia) {
  rustc_test("named-timer_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    link_deps = [ ":named_timer_noop_lib" ]
    deps = [
             ":fidl_rust",
             "//sdk/rust/zx",
             "//src/lib/fuchsia-async",
           ] + [ "//third_party/rust_crates:futures" ]
    output_name = "named_timer_lib_test"
    visibility = [ ":*" ]
  }
}

fuchsia_unittest_package("named-timer-test") {
  package_name = "named-timer-test-gn"
  component_name = "named-timer-test"
  deps = [ ":named-timer_test" ]
  visibility = [ ":*" ]
}
