import("//build/components.gni")

group("benchmarks") {
  deps = [ ":pkg" ]
  testonly = true
}

# TODO(https://fxbug.dev/570694755): Keep the benchmark package in GN while
# developer workflows in README.md and
# src/starnix/tests/kernel_core_bench/README.md invoke `fx set --with
# //src/lib/mapped-clock/benchmarks:pkg`.
fuchsia_package_with_single_component("pkg") {
  package_name = "mapped_clock_benchmarks"
  component_name = "mapped_clock_benchmarks"
  manifest = "meta/benchmarks.cml"
  deps = [ ":bin" ]
  testonly = true
}

