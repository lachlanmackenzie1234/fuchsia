import("//build/components.gni")
import("//build/rust/rustc_library.gni")
import("//build/rust/rustc_macro.gni")
import("//zircon/kernel/params.gni")

rustc_macro("ksync-macro") {
  edition = "2024"
  with_unit_tests = true
  source_root = "macro/src/lib.rs"
  sources = [ "macro/src/lib.rs" ]
  deps = [
    "//third_party/rust_crates:proc-macro2",
    "//third_party/rust_crates:quote",
    "//third_party/rust_crates:syn",
  ]
}

rustc_library("ksync") {
  edition = "2024"
  sources = [
    "src/brwlock.rs",
    "src/kcell.rs",
    "src/kmutex.rs",
    "src/konce_cell.rs",
    "src/lib.rs",
    "src/lock_token.rs",
    "src/lockdep_tracked.rs",
    "src/phantom_mutex.rs",
    "src/raw_lock.rs",
    "src/raw_userspace_brwlock.rs",
    "src/raw_userspace_mutex.rs",
    "src/singleton.rs",
  ]
  with_unit_tests = !is_kernel

  deps = [
    ":ksync-macro",
    "//src/lib/kstring",
    "//src/lib/lockdep/rust:lockdep",
    "//third_party/rust_crates:pin-init",
  ]

  if (is_kernel) {
    features = [ "kernel" ]
    if (enable_lock_dep) {
      features += [ "lock_dep" ]

      # `zr` is only used for the lockdep entry storage, and
      # `//zircon/kernel/lib/ksync` only for the `cpp_lock_dep_*` and
      # `cpp_lock_validate_*` FFI.
      deps += [
        "//src/lib/zr",
        "//zircon/kernel/lib/ksync",
      ]
    } else if (enable_lock_dep_metadata_only || lock_name_tracing_enabled ||
               scheduler_lock_spin_tracing_enabled) {
      features += [ "lock_metadata_only" ]
    }
  } else {
    deps += [
      "//src/lib/fuchsia-sync",
      "//third_party/rust_crates:lock_api",
    ]
  }
}

fuchsia_unittest_package("ksync-tests") {
  deps = [ ":ksync_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":ksync-macro_test($host_toolchain)",
    ":ksync-tests",
    ":ksync_test($host_toolchain)",
  ]
}

if (is_kernel) {
  import("//zircon/kernel/kernel_rust_mod.gni")

  kernel_rust_mod("ksync_kernel_tests") {
    testonly = true
    source_root = "tests/kernel.rs"
    sources = [ "tests/kernel.rs" ]
    test_deps = [
      ":ksync",
      "//src/lib/kprint",
      "//third_party/rust_crates:pin-init",
      "//zircon/kernel/lib/unittest:unittest-rs",
      "//zircon/system/ulib/fbl/rust:fbl",
    ]
  }
}
