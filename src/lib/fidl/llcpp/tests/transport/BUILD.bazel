load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_test_binary(
    name = "fidl_llcpp_transport_tests_bin",
    srcs = [
        "coding_test.cc",
        "context_test.cc",
        "waiter_test.cc",
    ],
    gn_output_name = "fidl_llcpp_transport_tests",
    deps = [
        "//sdk/lib/fidl/cpp/wire",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fidl_llcpp_transport_tests",
    unit_tests = [":fidl_llcpp_transport_tests_bin"],
    visibility = ["//src/lib:__pkg__"],
)

fx_cc_test_binary(
    name = "fidl_llcpp_channel_transport_tests_bin",
    srcs = ["channel_transport_test.cc"],
    gn_output_name = "fidl_llcpp_channel_transport_tests",
    deps = [
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/fidl/cpp/wire",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fidl_llcpp_channel_transport_tests",
    unit_tests = [":fidl_llcpp_channel_transport_tests_bin"],
    visibility = ["//src/lib:__pkg__"],
)

fx_cc_test_binary(
    name = "fidl_llcpp_transport_integration_tests_bin",
    srcs = [
        "socket_integration_test.cc",
        "transport_socket.cc",
        "transport_socket.h",
    ],
    gn_output_name = "fidl_llcpp_transport_integration_tests",
    deps = [
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/fidl/cpp/wire",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fidl_llcpp_transport_integration_tests",
    unit_tests = [":fidl_llcpp_transport_integration_tests_bin"],
    visibility = ["//src/lib:__pkg__"],
)
