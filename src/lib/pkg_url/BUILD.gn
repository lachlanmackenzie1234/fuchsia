import("//build/tools/bazel2gn/bazel_migration.gni")

source_set("pkg_url") {
  sources = [
    "fuchsia_pkg_url.cc",
    "url_resolver.cc",
  ]
  public = [
    "fuchsia_pkg_url.h",
    "url_resolver.h",
  ]
  deps = [
    "//sdk/lib/stdcompat",
    "//third_party/re2",
  ]
  visibility = [
    ":*",
    "//src/sys/fuzzing/common:*",
  ]
  public_deps = [ "//src/lib/fxl" ]
}

executable("tests") {
  testonly = true
  sources = [
    "fuchsia_pkg_url_unittest.cc",
    "url_resolver_unittest.cc",
  ]
  configs += [ "//build/config/lto:no-fat-lto-objects-linking" ]
  output_name = "pkg_url_unittests"
  deps = [
    ":pkg_url",
    "//src/lib/fxl/test:gtest_main",
  ]
}

fuchsia_unittest_package("pkg_url_unittests") {
  package_name = "pkg_url_unittests-gn"
  component_name = "pkg_url_unittests"
  deps = [ ":tests" ]
}
