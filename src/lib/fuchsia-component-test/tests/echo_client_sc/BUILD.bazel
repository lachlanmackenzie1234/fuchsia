load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_name = "echo_client_sc",
    edition = "2024",
    tags = ["manual"],
    deps = [
        ":config_lib",
        "//examples/components/routing/fidl:echo_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "echo_client_sc",
)

# The GN build uses the `fuchsia_component_manifest("manifest")` target defined
# above the bazel2gn sentinel in BUILD.gn instead, because
# `fuchsia_structured_config_values("config_values")` calls
# `get_target_outputs(":manifest")`.
# TODO(https://fxbug.dev/543568916): Remove `@bazel2gn:skip` once
# `fuchsia_structured_config_values` has an in-tree platform Bazel rule.
# @bazel2gn:skip
fx_component_manifest(
    name = "manifest",
    component_name = "echo_client_sc",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/echo_client_sc.cml",
)

fuchsia_structured_config_rust_lib(
    name = "config_lib",
    cm_label = ":manifest",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    visibility = ["//src/lib/fuchsia-component-test/tests:__pkg__"],
    deps = [":bin_packaged_bin"],
)
