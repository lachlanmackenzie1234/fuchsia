load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

# bazel2gn does not convert test_suite targets.
# @bazel2gn:skip
test_suite(
    name = "tests",
    tests = [],  # Include all tests in the package.
    visibility = ["//src/diagnostics:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/diagnostics.rs",
        "src/main.rs",
        "src/metrics.rs",
    ],
    crate_name = "inspect_system",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
        "//sdk/fidl/fuchsia.test:rust_measure_tape_for_case",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/reader",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/performance/lib/fuchsiaperf",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

# Needs reviewer attention (bazel2gn skip): Keeping the dual-built GN
# fuchsia_unittest_package wired alongside bazel_test_suite fails core.x64-asan
# testsharder ("some shard names are repeated: affected:AEMU") when
# use_test_pilot = true sets os = "linux" on the GN test;
# TODO(https://fxbug.dev/570694755).
# @bazel2gn:skip
rustc_test(
    name = "bin_test",
    crate = ":bin",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
)

# Run with `fx test inspect-system-unittests`
# Needs reviewer attention (bazel2gn skip): Keeping the dual-built GN
# fuchsia_unittest_package wired alongside bazel_test_suite fails core.x64-asan
# testsharder ("some shard names are repeated: affected:AEMU") when
# use_test_pilot = true sets os = "linux" on the GN test;
# TODO(https://fxbug.dev/570694755).
# @bazel2gn:skip
fx_unittest_package(
    name = "unittests",
    package_name = "inspect-system-unittests",
    unit_tests = [":bin_test"],
)
