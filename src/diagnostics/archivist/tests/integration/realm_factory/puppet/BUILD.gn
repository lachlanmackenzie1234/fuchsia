import("//build/components.gni")

fuchsia_component("puppet-component") {
  testonly = true
  component_name = "puppet"
  manifest = "meta/puppet.cml"
  deps = [ ":bin" ]
}

fuchsia_package("puppet") {
  testonly = true
  deps = [ ":puppet-component" ]
}

