load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["main.rs"],
    binary_name = "iquery_basic_component",
    crate_root = "main.rs",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
    deps = [
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fuchsia",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "iquery_basic_component",
    tags = ["manual"],
)

fx_component_manifest(
    name = "basic_component_manifest",
    testonly = True,
    component_name = "basic_component",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/basic_component.cml",
)

fx_component(
    name = "basic_component",
    testonly = True,
    compiled_manifest = ":basic_component_manifest",
    visibility = ["//src/diagnostics/iquery:__pkg__"],
    deps = [":bin_packaged"],
)
