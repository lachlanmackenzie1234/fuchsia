import("//build/components.gni")

# TODO(https://fxbug.dev/564213227): Migrate fuchsia_package("speedtest") once
# //bundles/tools and //src/developer/ffx/tests/e2e/python move to Bazel.
fuchsia_package("speedtest") {
  package_name = "speedtest"
  deps = [ ":component" ]
}

