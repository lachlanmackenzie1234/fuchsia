import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  output_name = "speedtest"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.developer.ffx.speedtest:fuchsia.developer.ffx.speedtest_rust",
    "//src/developer/ffx/tools/speedtest/common:speedtest",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component_manifest("component-manifest") {
  component_name = "speedtest"
  manifest = "meta/speedtest.cml"
}

fuchsia_component("component") {
  cm_label = ":component-manifest"
  deps = [ ":bin" ]
}
