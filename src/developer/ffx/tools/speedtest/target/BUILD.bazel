load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "speedtest",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.developer.ffx.speedtest:fuchsia.developer.ffx.speedtest_rust",
        "//src/developer/ffx/tools/speedtest/common:speedtest",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "speedtest",
)

fx_component_manifest(
    name = "component-manifest",
    component_name = "speedtest",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/speedtest.cml",
)

fx_component(
    name = "component",
    compiled_manifest = ":component-manifest",
    deps = [":bin_packaged_bin"],
)
