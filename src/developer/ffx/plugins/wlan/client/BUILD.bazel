load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_wlan_client",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//sdk/fidl/fuchsia.wlan.policy:fuchsia.wlan.policy_rust_fdomain",
        "//src/developer/ffx/core:lib",
        "//src/developer/ffx/plugins/wlan/common:ffx-wlan-common",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = ["//src/developer/ffx/plugins/wlan:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.wlan.policy:fuchsia.wlan.policy_rust_fdomain",
        "//src/connectivity/wlan/wlancfg/tool/policy:donut-lib-fdomain",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/target/holders:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/developer/ffx/plugins/wlan/common:ffx-wlan-common",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

host_rustc_test(
    name = "ffx_wlan_client_test",
    crate = ":ffx_wlan_client",
    visibility = ["//src/developer/ffx:__pkg__"],
)
