import("//build/tools/bazel2gn/bazel_migration.gni")

ffx_plugin("ffx_repository_publish") {
  sources = [ "src/lib.rs" ]
  args_deps = [ "//src/sys/pkg/lib/package-tool" ]
  args_sources = [ "src/args.rs" ]
  edition = "2024"
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  visibility = [
    ":*",
    "//src/developer/ffx/plugins/repository:*",
  ]
  deps = [
    "//src/developer/ffx/lib/fho:lib",
    "//src/developer/ffx/lib/writer:lib",
    "//src/sys/pkg/lib/package-tool",
    "//third_party/rust_crates:schemars",
    "//third_party/rust_crates:serde",
  ]
}
if (is_host) {
  rustc_test("ffx_repository_publish_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [
             ":ffx_repository_publish_args",
             "//src/developer/ffx/lib/fho:lib",
             "//src/developer/ffx/lib/writer:lib",
             "//src/sys/pkg/lib/package-tool",
             "//third_party/rust_crates:schemars",
             "//third_party/rust_crates:serde",
           ] +
           [
             "//src/lib/fuchsia",
             "//src/sys/pkg/lib/fuchsia-repo",
             "//third_party/rust_crates:chrono",
             "//third_party/rust_crates:serde_json",
           ]
    visibility = [
      ":*",
      "//src/developer/ffx:*",
    ]
  }
}
