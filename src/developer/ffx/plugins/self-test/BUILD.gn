import("//build/testing/host_test_data.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

assert(is_host, "bazel_ffx_tool() can only be called in a host toolchain.")

# LINT.IfChange
bazel_ffx_tool("ffx_selftest_tool") {
  output_name = "ffx-self-test"
}

# LINT.ThenChange(BUILD.bazel)

host_test_data("ffx_selftest_tool_test_data") {
  visibility = [
    "//src/developer/ffx/frontends/ffx:*",
    "//src/developer/ffx/tests/help-json:*",
  ]
  data_deps = [ ":ffx_selftest_tool_host_tool" ]
  sources = [
    "${host_tools_dir}/ffx-self-test",
    "${host_tools_dir}/ffx-self-test.json",
  ]
}
