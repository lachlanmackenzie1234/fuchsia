import("//build/tools/bazel2gn/bazel_migration.gni")

ffx_plugin("ffx_emulator_list") {
  sources = [ "src/lib.rs" ]
  args_deps = [
    "//src/developer/ffx/core:lib",
    "//third_party/rust_crates:argh",
  ]
  args_sources = [ "src/args.rs" ]
  edition = "2024"
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  visibility = [
    ":*",
    "//src/developer/ffx/plugins/emulator:*",
  ]
  deps = [
    "//src/developer/ffx/config:lib",
    "//src/developer/ffx/lib/emulator_instance:lib",
    "//src/developer/ffx/lib/fho:lib",
    "//src/developer/ffx/lib/writer:lib",
    "//src/developer/ffx/plugins/emulator/commands/list/command_output",
    "//third_party/rust_crates:anyhow",
  ]
}
if (is_host) {
  rustc_test("ffx_emulator_list_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps =
        [
          ":ffx_emulator_list_args",
          "//src/developer/ffx/config:lib",
          "//src/developer/ffx/lib/emulator_instance:lib",
          "//src/developer/ffx/lib/fho:lib",
          "//src/developer/ffx/lib/writer:lib",
          "//src/developer/ffx/plugins/emulator/commands/list/command_output",
          "//third_party/rust_crates:anyhow",
        ] +
        [
          "//src/lib/fuchsia",
          "//third_party/rust_crates:mockall",
          "//third_party/rust_crates:serde_json",
        ]
    visibility = [
      ":*",
      "//src/developer/ffx:*",
    ]
  }
}
