load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

fx_component_manifest(
    name = "fake_crash_reporter_manifest",
    testonly = True,
    component_name = "fake_crash_reporter",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/fake_crash_reporter.cml",
)

fx_component(
    name = "fake_crash_reporter",
    testonly = True,
    compiled_manifest = ":fake_crash_reporter_manifest",
    visibility = [
        "//src/developer/forensics:__subpackages__",
        "//src/power/system-activity-governor:__subpackages__",
    ],
    deps = [":fake_crash_reporter_exe_packaged_bin"],
)

fx_cc_binary(
    name = "fake_crash_reporter_exe",
    testonly = True,
    srcs = [
        "crash_reporter.cc",
        "crash_reporter.h",
        "crash_reporter_main.cc",
    ],
    tags = ["manual"],
    deps = [
        ":fuchsia.feedback.testing_cpp",
        "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/outgoing/cpp",
        "//sdk/lib/syslog/cpp",
    ],
)

fx_packaged_binary(
    name = "fake_crash_reporter_exe_packaged_bin",
    testonly = True,
    binary = ":fake_crash_reporter_exe",
    binary_name = "fake_crash_reporter_exe",
)

fidl_library(
    name = "fuchsia.feedback.testing",
    testonly = True,
    srcs = ["query.test.fidl"],
    enable_hlcpp = True,
    visibility = [
        "//src/developer/forensics:__subpackages__",
        "//src/power/system-activity-governor:__subpackages__",
    ],
)
