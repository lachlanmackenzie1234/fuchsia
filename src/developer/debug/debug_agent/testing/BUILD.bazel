load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "runtime_dir_helper",
    testonly = True,
    srcs = ["runtime_dir_helper.cc"],
    hdrs = ["runtime_dir_helper.h"],
    # Matches the assert(is_fuchsia) in the original BUILD.gn.
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//src/developer/debug/debug_agent:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/syslog/cpp",
        "//src/storage/lib/vfs/cpp",
        "//zircon/system/ulib/fbl",
        "@com_google_googletest//:gtest",
    ],
    alwayslink = True,
)
