import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The unit test stays in GN because it uses RealmBuilder, whose
# realm_builder_server is not built by Bazel.
rustc_test("factoryctl_bin_test") {
  edition = "2024"
  source_root = "src/main.rs"
  sources = [ "src/main.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust",
    "//sdk/fidl/fuchsia.factory:fuchsia.factory_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//src/lib/fuchsia-fs",
    "//src/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:clap",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:nom",
  ]
}

# `factoryctl_tests` stays in GN because the test uses RealmBuilder and
# `//src/lib/fuchsia-component-test/realm_builder_server` has no Bazel build
# yet.
fuchsia_unittest_package("factoryctl_tests") {
  deps = [ ":factoryctl_bin_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":factoryctl_tests" ]
}
