import("//build/config/sysroot.gni")
import("//zircon/vdso/vdso.gni")

# This file defines the sysroot entries corresponding to the Zircon VDSO
# (a.k.a. libzircon.so). More details about how these are used are in
# //sdk/lib/c/sysroot_entries.gni.

_rebased_include_dir =
    rebase_path("//src/zircon/lib/zircon/include", root_build_dir)

if (target_sysroot != "") {
  _vdso_link_label = []
  _vdso_source =
      rebase_path("${target_sysroot}/lib/libzircon.so", root_build_dir)
  _vdso_link = _vdso_source
} else {
  _vdso_link_target = "//src/zircon/lib/zircon:zircon.stub($default_toolchain)"
  _vdso_link_label = [ _vdso_link_target ]
  _vdso_link =
      get_label_info(_vdso_link_target, "target_out_dir") + "/libzircon.so"
  _vdso_source = rebase_path(_vdso_link, root_build_dir)
}

sysroot_vdso_entries = [
  {
    vdso = _vdso_link
  },
  {
    include_dirs = []
    include_dirs = [ _rebased_include_dir ]
  },
  {
    sdk = {
      include_dir = _rebased_include_dir
      headers = [ "zircon/status.h" ]
    }
  },
  {
    sdk = {
      include_dir = _rebased_include_dir
      headers = [ "zircon/exception.h" ]
    }
  },
  {
    sdk = {
      source = _vdso_source
      link = "lib/libzircon.so"
      deps = _vdso_link_label
    }
  },
]
