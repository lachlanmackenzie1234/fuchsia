load("//build/bazel/rules/cc:fx_cc_library_headers.bzl", "fx_cc_library_headers")

package(default_applicable_licenses = ["//:license"])

# <lib/ot-stack/ot-stack-callback.h> includes
# <fidl/fuchsia.lowpan.spinel/cpp/wire.h>, which GN library_headers exposes
# via public_deps.
# @bazel2gn:raw_attribute:public_deps = [ "//sdk/fidl/fuchsia.lowpan.spinel:fuchsia.lowpan.spinel_cpp" ]
fx_cc_library_headers(
    name = "ot-stack-callback",
    hdrs = ["include/lib/ot-stack/ot-stack-callback.h"],
    visibility = ["//src/connectivity/openthread/third_party/openthread/platform:__pkg__"],
    # fx_cc_library_headers uses deps for public header dependencies; GN
    # library_headers uses public_deps (emitted above).
    # @bazel2gn:skip
    deps = ["//sdk/fidl/fuchsia.lowpan.spinel:fuchsia.lowpan.spinel_cpp"],
)
