load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

py_library(
    name = "common",
    testonly = True,
    srcs = [
        "__init__.py",
        "utils/ies.py",
    ],
    imports = [".."],
    # Bazel only registers a host Python toolchain; GN python_library is not gated on is_host.
    target_compatible_with = HOST_OS_CONSTRAINTS,  # @bazel2gn:skip
    visibility = [
        "//src/connectivity/wlan/tests/core:__pkg__",
        "//src/connectivity/wlan/tests/wlanix:__pkg__",
    ],
)
