load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")
load("//src/developer/ffx/build:ffx_tool.bzl", "ffx_tool")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_net_test_realm",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//src/lib/network/fidl_fuchsia_net_ext",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    sdk_category = "not-yet-specified",
    deps = [
        "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_fdomain",
        "//sdk/fidl/fuchsia.net.dhcpv6:fuchsia.net.dhcpv6_rust_fdomain",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust_fdomain",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain",
        "//src/connectivity/lib/fidl_fuchsia_net_dhcpv6_ext",
        "//src/connectivity/network/testing/network-test-realm/fidl:fuchsia.net.test.realm_rust_fdomain",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/target/holders:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/lib/fdomain/client",
        "//src/lib/network/fidl_fuchsia_net_ext",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:uuid",
    ],
)

ffx_tool(
    name = "ffx_net_test_realm_tool",
    srcs = ["src/main.rs"],
    binary_name = "ffx-net-test-realm",
    edition = "2024",
    deps = [
        ":ffx_net_test_realm",
        "//src/developer/ffx/lib/fho:lib",
        "//src/lib/fuchsia",
    ],
)

host_rustc_test(
    name = "ffx_net_test_realm_test",
    crate = ":ffx_net_test_realm",
    deps = [
        "//src/connectivity/lib/net-declare",
        "//src/lib/fdomain/local",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
    ],
)
