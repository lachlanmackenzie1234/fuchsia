load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "unreliable_echo",
    edition = "2024",
    tags = ["manual"],
    deps = [
        ":lib",
        "//src/connectivity/network/testing/network-test-realm/fidl:fuchsia.net.test.realm_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin.packaged",
    binary = ":bin",
    binary_name = "unreliable_echo",
)

# Match GN disable_rustdoc = true; Bazel rustc_library does not generate rustdoc by default.
# @bazel2gn:raw_attribute:disable_rustdoc = true
rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "unreliable_echo",
    edition = "2024",
    visibility = ["//src/connectivity/network/testing/network-test-realm/tests:__pkg__"],
)

fx_component_manifest(
    name = "unreliable-echo-v4_manifest",
    component_name = "unreliable-echo-v4",
    includes = ["//src/connectivity/network/testing/network-test-realm/meta:stub-socket-client.shard"],
    manifest = "meta/unreliable-echo-v4.cml",
)

fx_component(
    name = "unreliable-echo-v4",
    compiled_manifest = ":unreliable-echo-v4_manifest",
    visibility = ["//src/connectivity/network/testing/network-test-realm/tests:__pkg__"],
    deps = [":bin.packaged"],
)

fx_component_manifest(
    name = "unreliable-echo-v6_manifest",
    component_name = "unreliable-echo-v6",
    includes = ["//src/connectivity/network/testing/network-test-realm/meta:stub-socket-client.shard"],
    manifest = "meta/unreliable-echo-v6.cml",
)

fx_component(
    name = "unreliable-echo-v6",
    compiled_manifest = ":unreliable-echo-v6_manifest",
    visibility = ["//src/connectivity/network/testing/network-test-realm/tests:__pkg__"],
    deps = [":bin.packaged"],
)
