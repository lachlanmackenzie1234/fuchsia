import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("netstack3-benchmarks") {
  testonly = true
  sources = [
    "src/forwarding.rs",
    "src/main.rs",
  ]
  configs += [
    "//build/config/rust/lints:deny_unused_results",
    "//src/connectivity/network/netstack3/core:benchmark",
  ]
  output_name = "netstack3_benchmarks"
  edition = "2024"
  deps = [
    "//src/connectivity/lib/net-types",
    "//src/connectivity/lib/packet-formats",
    "//src/connectivity/network/netstack3/core:netstack3-core-benchmarks",
    "//src/connectivity/network/netstack3/core/base:netstack3-base-benchmarks",
    "//src/developer/fuchsia-criterion",
    "//src/lib/network/packet",
    "//third_party/rust_crates:criterion",
  ]
}

rustc_test("netstack3-benchmarks_test") {
  sources = [
    "src/forwarding.rs",
    "src/main.rs",
  ]
  edition = "2024"
  deps = [
    "//src/connectivity/lib/net-types",
    "//src/connectivity/lib/packet-formats",
    "//src/connectivity/network/netstack3/core:netstack3-core-benchmarks",
    "//src/connectivity/network/netstack3/core/base:netstack3-base-benchmarks",
    "//src/developer/fuchsia-criterion",
    "//src/lib/network/packet",
    "//third_party/rust_crates:criterion",
  ]
  source_root = "src/main.rs"
  configs += [
    "//build/config/rust/lints:deny_unused_results",
    "//src/connectivity/network/netstack3/core:benchmark",
  ]
}

fuchsia_unittest_package("netstack3-benchmarks-test") {
  package_name = "netstack3-benchmarks-test-gn"
  component_name = "netstack3-benchmarks-test"
  deps = [ ":netstack3-benchmarks_test" ]
  visibility = [
    ":*",
    "//src/connectivity/network:*",
  ]
}
