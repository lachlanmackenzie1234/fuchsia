import("//build/bazel/bazel_fuchsia_package.gni")

# //src/connectivity/network/tests/integration/common lists `:pkg` in `deps` on
# `netstack_testing_common`, which expands on non-default variant toolchains.
if (current_toolchain == default_toolchain) {
  bazel_fuchsia_package("pkg") {
    testonly = true
    bazel_config = "fuchsia_platform"
    package_name = "fake_socket_proxy"
  }
} else {
  group("pkg") {
    testonly = true
  }
}

