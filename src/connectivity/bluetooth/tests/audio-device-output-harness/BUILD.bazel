load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "audio_device_output_harness",
    edition = "2024",
    # Packaged into :audio-device-output-harness via :bin_packaged.
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.media:fuchsia.media_rust",
        "//sdk/rust/zx",
        "//src/connectivity/bluetooth/lib/fuchsia-audio-device",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "audio_device_output_harness",
)

fx_component_manifest(
    name = "audio-device-output-harness-manifest",
    component_name = "audio-device-output-harness",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/audio-device-output-harness.cml",
)

fx_component(
    name = "audio-device-output-harness",
    compiled_manifest = ":audio-device-output-harness-manifest",
    visibility = ["//src/media/audio/drivers/tests:__pkg__"],
    deps = [":bin_packaged"],
)
