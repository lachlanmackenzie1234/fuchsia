load("//build/bazel/aspects:runner.bzl", "fx_runner_shard")
load("//build/bazel/rules/components:cml_shard.bzl", "cml_shard")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "coverage.shard.cml",
        "elf_test_runner.shard.cml",
    ],
    visibility = [
        "//build/bazel/rules/components:__pkg__",
        "//build/bazel/rules/packages/tests:__pkg__",
        "//build/bazel/rules/testing:__pkg__",
        "//src:__subpackages__",
    ],
)

fx_runner_shard(
    name = "elf_test_runner",
    shard = "elf_test_runner.shard.cml",
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "rust_test_runner.shard.cml",
    ],
    visibility = ["//src/lib/atomic-storage:__pkg__"],
)

cml_shard(
    name = "rust_test_runner.shard",
    shard = "rust_test_runner.shard.cml",
    visibility = ["//src/media/haptics:__pkg__"],
)
