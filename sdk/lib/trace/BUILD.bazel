load("//build/bazel/rules/components:cml_shard.bzl", "cml_shard")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "offer.shard.cml",
        "client.shard.cml",
        "use.shard.cml",
    ],
    visibility = [
        "//bundles/assembly:__subpackages__",
        "//sdk/lib/vulkan:__pkg__",
        "//src/connectivity/policy/http-client:__pkg__",
        "//src/starnix/modules/usbfs:__pkg__",
    ],
)

cml_shard(
    name = "offer.shard",
    shard = "offer.shard.cml",
)

cml_shard(
    name = "use.shard",
    shard = "use.shard.cml",
    visibility = ["//src/virtualization/bin/vmm/device:__subpackages__"],
)

cml_shard(
    name = "client.shard",
    includes = [
        ":offer.shard",
        ":use.shard",
    ],
    shard = "client.shard.cml",
    visibility = ["//src/sys/time/timekeeper:__pkg__"],
)
