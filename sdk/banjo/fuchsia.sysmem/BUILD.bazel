load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "fuchsia.sysmem",
    srcs = [
        "constraints.fidl",
        "format_modifier.fidl",
        "image_formats.fidl",
        "image_formats_deprecated.fidl",
        "overview.fidl",
        "usages.fidl",
    ],
    enable_banjo = True,
    visibility = [
        "//sdk/banjo/fuchsia.hardware.gdc:__pkg__",
        "//sdk/banjo/fuchsia.hardware.ge2d:__pkg__",
        "//sdk/banjo/fuchsia.hardware.isp:__pkg__",
        "//src/camera/drivers/hw_accel/task:__pkg__",
        "//src/devices/lib/sysmem:__pkg__",
        "//vendor:__subpackages__",
    ],
    deps = ["//zircon/vdso/zx"],
)
