load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "fuchsia.hardware.camera",
    srcs = ["camera.fidl"],
    enable_banjo = True,
    visibility = [
        "//sdk/banjo/fuchsia.hardware.camera.sensor:__pkg__",
        "//sdk/banjo/fuchsia.hardware.ge2d:__pkg__",
        "//sdk/banjo/fuchsia.hardware.isp:__pkg__",
        "//sdk/banjo/fuchsia.hardware.mipicsi:__pkg__",
        "//src/camera/drivers/sensors/imx227:__pkg__",
        "//vendor:__subpackages__",
    ],
)
