import("//build/rust/rustc_test.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

if (is_kernel) {
  kernel_rust_mod("profile-rs") {
    sources = [ "profile.rs" ]
    deps = [
      "//src/lib/zr",
      "//zircon/kernel/lib/page:page-rs",
    ]
  }
} else if (is_host) {
  rustc_test("profile_test") {
    edition = "2024"
    source_root = "profile.rs"
    sources = [ "profile.rs" ]
    deps = [
      "//src/lib/zr",
      "//third_party/rust_crates:zerocopy",
      "//zircon/kernel/lib/page:page-rs",
    ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":profile_test($host_toolchain)" ]
}
