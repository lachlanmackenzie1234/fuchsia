import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [ "lib/heap.h" ]
}

library_headers("headers.internal") {
  visibility = [ "./*" ]

  headers = [ "lib/heap_internal.h" ]
}

source_set("heap") {
  public_deps = [ ":headers" ]

  sources = [ "cxx_allocator.cc" ]
  deps = [
    "cmpctmalloc",
    "//zircon/kernel/lib/instrumentation:headers",
    "//zircon/kernel/phys/handoff:headers",
  ]
}

kernel_rust_mod("heap-rs") {
  sources = [
    "heap.rs",
    "heap_ffi.rs",
    "heap_wrapper.rs",
  ]
  deps = [
    "cmpctmalloc:cmpctmalloc-rs",
    "profile:profile-rs",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/backtrace:backtrace-rs",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/instrumentation/asan:asan-rs",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/kernel/lib/virtual_alloc:virtual_alloc-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
}

group("tests") {
  testonly = true
  deps = [
    "cmpctmalloc:tests",
    "profile:tests",
  ]
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
