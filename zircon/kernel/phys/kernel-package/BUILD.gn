import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [ "phys/kernel-package/kernel-package.h" ]

  public_deps = [
    "//zircon/kernel/lib/ktl",

    # <phys/kernel-package/kernel-package.h> has #include
    # <lib/zbitl/items/bootfs.h> <phys/kernel-package/kernel-package.h> has
    # #include <lib/zbitl/view.h>
    "//src/lib/zbitl:headers",

    # <phys/kernel-package/kernel-package.h> has #include <phys/allocation.h>
    "//zircon/kernel/phys:allocation",

    # <phys/kernel-package/kernel-package.h> has #include
    # <phys/handoff/handoff.h>
    "../handoff:headers",
  ]
}

static_library("kernel-package") {
  complete_static_lib = true

  public_deps = [ ":headers" ]

  sources = [ "kernel-package.cc" ]
  deps = [
    "..:main",
    "..:stdio",
    "..:symbolize",
    "..:zbitl-allocation",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/libc",
    "//zircon/system/ulib/pretty",
  ]
}
