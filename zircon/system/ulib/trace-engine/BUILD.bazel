load("//build/bazel/rules/idk:idk_cc_prebuilt_library.bzl", "idk_cc_shared_library_zx")
load("//build/bazel/rules/idk:idk_cc_source_library.bzl", "idk_cc_source_library")

package(default_applicable_licenses = ["//:license"])

idk_cc_shared_library_zx(
    name = "trace-engine",
    srcs = [
        "buffer.cc",
        "buffer.h",
        "context.cc",
        "context_api.cc",
        "context_impl.h",
        "engine.cc",
        "hash_table.h",
        "include/lib/trace-engine/buffer_internal.h",
        "nonce.cc",
        "rolling_buffer.cc",
        "rolling_buffer.h",
    ],
    hdrs = [
        "include/lib/trace-engine/context.h",
        "include/lib/trace-engine/fields.h",
        "include/lib/trace-engine/handler.h",
        "include/lib/trace-engine/instrumentation.h",
        "include/lib/trace-engine/types.h",
    ],
    api_area = "Diagnostics",
    api_file_path = "//sdk/lib/trace-engine:trace-engine.api",
    category = "partner",
    idk_name = "trace-engine",
    implementation_deps = [
        "//sdk/lib/async:async-cpp",
        "//zircon/system/ulib/zx",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/lib/trace/rust:__pkg__",
        "//src/storage/lib/vfs/rust:__pkg__",
        "//zircon/system/ulib/trace:__pkg__",
        "//zircon/system/ulib/trace-provider:__pkg__",
    ],
    deps = [
        ":trace-engine-headersonly",

        # <trace-engine/handler.h> has #include <lib/async/dispatcher.h>.
        "//sdk/lib/async",
    ],
)

# Header-only source package for use by trace-provider:handler,
# which is engine-agnostic.
idk_cc_source_library(
    name = "trace-engine-headersonly",
    srcs = ["include/lib/trace-engine/buffer_internal.h"],
    hdrs = [
        "include/lib/trace-engine/context.h",
        "include/lib/trace-engine/fields.h",
        "include/lib/trace-engine/handler.h",
        "include/lib/trace-engine/instrumentation.h",
        "include/lib/trace-engine/types.h",
    ],
    api_area = "Diagnostics",
    category = "partner",
    idk_name = "trace-engine-headersonly",
    stable = True,
    visibility = ["//visibility:private"],
    deps = [
        # <trace-engine/handler.h> has #include <lib/async/dispatcher.h>.
        "//sdk/lib/async",
    ],
)
