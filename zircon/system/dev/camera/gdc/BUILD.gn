driver("gdc") {
  sources = [
    "gdc.cpp",
    "test/gdc-test.cpp",
  ]
  deps = [
    ":gdc-task",
    "$zx/system/banjo/ddk.protocol.clock",
    "$zx/system/banjo/ddk.protocol.composite",
    "$zx/system/banjo/ddk.protocol.gdc",
    "$zx/system/banjo/ddk.protocol.platform.bus",
    "$zx/system/banjo/ddk.protocol.platform.device",
    "$zx/system/banjo/ddk.protocol.sysmem",
    "$zx/system/dev/lib/mmio",
    "$zx/system/fidl/fuchsia-sysmem:c",
    "$zx/system/ulib/ddk",
    "$zx/system/ulib/ddktl",
    "$zx/system/ulib/fbl",
    "$zx/system/ulib/fidl-utils",
    "$zx/system/ulib/fit",
    "$zx/system/ulib/fzl",
    "$zx/system/ulib/hwreg",
    "$zx/system/ulib/sync",
    "$zx/system/ulib/zircon",
    "$zx/system/ulib/zx",
    "$zx/system/ulib/zxtest",
  ]

  # TODO(ZX-2863): This driver violates the allowed shlib deps policy.
  deprecated_inhibit_driver_shlib_allowlist = true
}

source_set("gdc-task") {
  visibility = [ "./*" ]
  sources = [
    "task.cpp",
  ]
  deps = [
    "$zx/system/banjo/ddk.protocol.gdc",
    "$zx/system/fidl/fuchsia-sysmem:c",
    "$zx/system/ulib/ddk",
    "$zx/system/ulib/ddktl",
    "$zx/system/ulib/fzl",
    "$zx/system/ulib/sync",
    "$zx/system/ulib/syslog",
    "$zx/system/ulib/zircon",
    "$zx/system/ulib/zx",
  ]
}
