load(
    "//build/bazel/rules/cc:fx_cc_binary.bzl",
    "fx_cc_binary",
)
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

# fx_cc_binary names the binary after the target; GN sets output_name.
# @bazel2gn:raw_attribute:output_name = "fidl_echo_cpp_wire_service_server"
fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    tags = ["manual"],
    deps = [
        "//examples/fidl/fuchsia.examples:fuchsia.examples_cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/outgoing/cpp",
        "//sdk/lib/fidl",
        "//sdk/lib/sys/cpp",
        "//zircon/system/ulib/svc",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "fidl_echo_cpp_wire_service_server",
)

fx_component_manifest(
    name = "echo-server-manifest",
    component_name = "echo_server",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/server.cml",
)

fx_component(
    name = "echo-server",
    compiled_manifest = ":echo-server-manifest",
    visibility = [
        "//examples/fidl/cpp/services:__pkg__",
        "//examples/fidl/echo-realm:__pkg__",
    ],
    deps = [":bin_packaged"],
)
