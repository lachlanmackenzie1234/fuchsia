load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "reverser_library",
    srcs = ["reverser.cc"],
    hdrs = ["reverser.h"],
    alwayslink = True,
)

fx_cc_binary(
    name = "reverser_library_test",
    testonly = True,
    srcs = ["reverser_test.cc"],
    tags = ["manual"],
    deps = [
        ":reverser_library",
        "//src/lib/fxl/test:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)

fx_unittest_package(
    name = "reverser_library_unittest",
    unit_tests = [":reverser_library_test"],
    visibility = ["//examples:__pkg__"],
)
