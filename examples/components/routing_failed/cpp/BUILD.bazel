load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")

package(default_applicable_licenses = ["//:license"])

# fx_cc_binary does not support output_name in Bazel.
# @bazel2gn:raw_attribute:output_name = "routing_failed_echo_client_cpp"
fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    deps = [
        "//examples/components/routing/fidl:echo_cpp",
        "//sdk/lib/async",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/syslog/cpp",
    ],
)
