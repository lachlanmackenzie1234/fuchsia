  output_name = "provider_bin_cpp"
  deps = [
    "//examples/components/services/fidl:fuchsia.examples.services_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
