load("@rules_rust//rust:rust_shared_library.bzl", "rust_shared_library")
load("//build/bazel/rules/rust:common.bzl", "with_fuchsia_rust_stdlib_link_deps")

package(default_applicable_licenses = ["//:license"])

exports_files(
    ["crust.h"],
    visibility = ["//examples/rust/cdylib:__pkg__"],
)

# LINT.IfChange(crust_cdylib)
# bazel2gn does not support rust_shared_library; kept in BUILD.gn for //examples/rust/cdylib.
# @bazel2gn:skip
rust_shared_library(
    name = "crust-shared",
    srcs = ["src/lib.rs"],
    crate_name = "crust_shared_rust",
    edition = "2024",
    link_deps = with_fuchsia_rust_stdlib_link_deps([]),
    visibility = ["//examples/rust/cdylib:__pkg__"],
)

# @bazel2gn:skip
rust_shared_library(
    name = "crust-loadable",
    srcs = ["src/lib.rs"],
    crate_name = "crust_loadable_rust",
    edition = "2024",
    link_deps = with_fuchsia_rust_stdlib_link_deps([]),
    visibility = ["//examples/rust/cdylib:__pkg__"],
)
# LINT.ThenChange(BUILD.gn:crust_cdylib)
