load("@rules_rust//rust:rust_static_library.bzl", "rust_static_library")

package(default_applicable_licenses = ["//:license"])

exports_files(
    ["crust.h"],
    visibility = ["//examples/rust/staticlib:__pkg__"],
)

# LINT.IfChange(crust)
# bazel2gn does not support rust_static_library; kept in BUILD.gn for //examples/rust/staticlib.
# @bazel2gn:skip
rust_static_library(
    name = "crust",
    srcs = ["src/lib.rs"],
    crate_name = "crust_rust",
    edition = "2024",
    visibility = ["//examples/rust/staticlib:__pkg__"],
)
# LINT.ThenChange(BUILD.gn:crust)
