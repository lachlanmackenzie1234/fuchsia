import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("rust_extract") {
    bazel_target = ":rust_extract"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/rust_extract"
    install_host_tool = true
  }
}
