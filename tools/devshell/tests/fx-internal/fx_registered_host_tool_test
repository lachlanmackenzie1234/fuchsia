  },
  "google-only-cmd": {
    "script": "//vendor/google/scripts/devshell/reg_flash.sh",
    "summary": "google top-level registered tool"
  }
}
EOF

  out="$(PATH="/usr/bin:/bin" "${fx}" flash-kola 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out}" "REG_GOOGLE_FLASH_KOLA|FLAG=0|"
  if [[ "${out}" == *"/third_party/clang/"* ]]; then
    BT_FAIL "Expected registered vendor tool to have FX_INJECT_PREBUILT_PATHS=0, got: ${out}"
  fi

  local vendor_help
  vendor_help="$("${fx}" vendor 2>&1)"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${vendor_help}" "vendor google flash-kola"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${vendor_help}" "google registered flash-kola"
  local occ_flash
  occ_flash="$(printf '%s\n' "${vendor_help}" | grep -c "vendor google flash-kola" || true)"
  BT_EXPECT_EQ "${occ_flash}" 1

  out="$(PATH="/usr/bin:/bin" "${fx}" google-only-cmd 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out}" "REG_GOOGLE_FLASH_KOLA|FLAG=0|"

  source "${BT_TEMP_DIR}/tools/devshell/lib/vars.sh"
  source "${BT_TEMP_DIR}/tools/devshell/lib/fx-cmd-locator.sh"
  local all_reg
  all_reg="$(list_registered_host_tools)"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${all_reg}" "google-only-cmd"

  mkdir -p "${BT_TEMP_DIR}/vendor/acme/scripts/devshell"
  cat > "${BT_TEMP_DIR}/vendor/acme/scripts/devshell/acme_flash.sh" <<'EOF'
#!/bin/bash
echo "REG_ACME_FLASH_KOLA|FLAG=${FX_INJECT_PREBUILT_PATHS:-unset}"
EOF
  chmod +x "${BT_TEMP_DIR}/vendor/acme/scripts/devshell/acme_flash.sh"
  cat > "${BT_TEMP_DIR}/vendor/acme/scripts/devshell/fx_host_tools.json" <<'EOF'
{
  "flash-kola": {
    "script": "//vendor/acme/scripts/devshell/acme_flash.sh",
    "summary": "acme registered flash-kola"
  }
}
EOF

  local coll_err
  coll_err="$("${fx}" flash-kola 2>&1)"
  local coll_rc=$?
  BT_EXPECT_EQ "${coll_rc}" 2
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${coll_err}" "acme"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${coll_err}" "google"

  local help_coll_err
  help_coll_err="$("${fx}" help flash-kola 2>&1)"
  local help_coll_rc=$?
  BT_EXPECT_EQ "${help_coll_rc}" 2
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${help_coll_err}" "acme"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${help_coll_err}" "google"

  out="$(PATH="/usr/bin:/bin" "${fx}" vendor acme flash-kola 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out}" "REG_ACME_FLASH_KOLA|FLAG=0"
}

