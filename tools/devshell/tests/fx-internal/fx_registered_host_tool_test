EOF
  chmod +x "${caller_script}"
  caller_out="$("${fx}" caller-script-cmd 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${caller_out}" "SH_OK|"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${caller_out}" "ARGS=from-run"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${caller_out}" "PY_SIBLING_OK|"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${caller_out}" "ARGS=from-py-run"

  BT_ASSERT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/.fx-build-dir"
}

TEST_large_registry_no_build_dispatch_stays_subsecond() {
  mkdir -p "${BT_TEMP_DIR}/tools/devshell/host_tools/fast_sh"
  cat > "${BT_TEMP_DIR}/tools/devshell/host_tools/fast_sh/fast.sh" <<'EOF'
#!/bin/bash
echo "fast-v1|args=$*"
EOF
  chmod +x "${BT_TEMP_DIR}/tools/devshell/host_tools/fast_sh/fast.sh"

  "${_TEST_PY3}" - "${BT_TEMP_DIR}/tools/devshell/fx_host_tools.json.orig" "${BT_TEMP_DIR}/tools/devshell/fx_host_tools.json" <<'PY'
import json
import sys

data = json.loads(open(sys.argv[1], encoding="utf-8").read())
data["my-fast-tool"] = {
    "category": "Build",
    "summary": "Target under \"latency\" test",
    "script": "//tools/devshell/host_tools/fast_sh/fast.sh",
}
with open(sys.argv[2], "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY

  "${fx}" my-fast-tool warmup >/dev/null 2>&1
  BT_EXPECT_EQ $? 0

  local start_us="${EPOCHREALTIME/./}"
  local out
  out="$(LC_ALL=C.UTF-8 "${fx}" my-fast-tool --ping 2>/dev/null)"
  local rc=$?
  local end_us="${EPOCHREALTIME/./}"
  local elapsed_ms=$(( (10#${end_us} - 10#${start_us}) / 1000 ))

  BT_EXPECT_EQ "${rc}" 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out}" "fast-v1|"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out}" "args=--ping"
  if (( elapsed_ms >= 1000 )); then
    BT_FAIL "Expected 'fx' dispatch with full registry to finish in <1000ms, took ${elapsed_ms}ms"
  fi
}

