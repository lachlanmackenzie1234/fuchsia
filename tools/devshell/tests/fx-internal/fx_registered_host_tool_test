  mkdir -p "${BT_TEMP_DIR}/tools/devshell/host_tools/mock_sh"
  cat > "${BT_TEMP_DIR}/tools/devshell/host_tools/mock_sh/mock_sh.sh" <<'EOF'
#!/bin/bash
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "usage: fx mock-sh [--arg]"
  exit 0
fi
echo "SH_OK|FLAG=${FX_INJECT_PREBUILT_PATHS:-unset}|ARGS=$*"
