TEST_single_python_invocation_per_command_dispatch() {
  local real_py3
  real_py3="$(command -v python3)"
  local py_wrapper="${BT_TEMP_DIR}/_mock_bin/py3_spy"
  mkdir -p "$(dirname "${py_wrapper}")"
  cat > "${py_wrapper}" <<EOF
#!/bin/bash
for arg in "\$@"; do
  if [[ "\${arg}" == *"locator.py"* || "\${arg}" == *"registry.py"* ]]; then
    printf '%s\n' "\$*" >> "${BT_TEMP_DIR}/_py_calls.log"
    break
  fi
done
exec "${real_py3}" "\$@"
EOF
  chmod +x "${py_wrapper}"
  ln -sf "${py_wrapper}" "${_TEST_PY3}"

  _count_py_calls() {
    if [[ -f "${BT_TEMP_DIR}/_py_calls.log" ]]; then
      wc -l < "${BT_TEMP_DIR}/_py_calls.log" | tr -d ' '
    else
      echo 0
    fi
  }

  mkdir -p "${BT_TEMP_DIR}/tools/devshell/host_tools/single_sh"
  cat > "${BT_TEMP_DIR}/tools/devshell/host_tools/single_sh/single_sh.sh" <<'EOF'
#!/bin/bash
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "usage: fx single-sh [--flag]"
  exit 0
fi
echo "SINGLE_SH_OK|$*"
EOF
  chmod +x "${BT_TEMP_DIR}/tools/devshell/host_tools/single_sh/single_sh.sh"

  cat > "${BT_TEMP_DIR}/tools/devshell/fx_host_tools.json" <<'EOF'
{
  "single-sh": {
    "category": "Build",
    "script": "//tools/devshell/host_tools/single_sh/single_sh.sh",
    "summary": "single-sh tool summary"
  },
  "single-target-unbuilt": {
    "category": "Build",
    "summary": "unbuilt target summary",
    "target": "//scripts/developer:single-target-unbuilt"
  },
  "single-target-built": {
    "category": "Build",
    "summary": "built target summary",
    "target": "//scripts/developer:single-target-built"
  }
}
EOF

  # Set up built mock binary in both host-tools (Commit 1) and _fx_host_tools (Commit 3+)
  mkdir -p "${BT_TEMP_DIR}/out/default/host-tools" "${BT_TEMP_DIR}/out/_fx_host_tools"
  cat > "${BT_TEMP_DIR}/out/default/host-tools/single-target-built" <<'EOF'
#!/bin/bash
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "BUILT_TARGET_HELP"
  exit 0
fi
echo "BUILT_TARGET_OK"
EOF
  chmod +x "${BT_TEMP_DIR}/out/default/host-tools/single-target-built"
  cp -f "${BT_TEMP_DIR}/out/default/host-tools/single-target-built" "${BT_TEMP_DIR}/out/_fx_host_tools/single-target-built"

  # Vendor setup
  mkdir -p "${BT_TEMP_DIR}/vendor/acme/scripts/devshell"
  cat > "${BT_TEMP_DIR}/vendor/acme/scripts/devshell/v_single.sh" <<'EOF'
#!/bin/bash
echo "V_SINGLE_OK|$*"
EOF
  chmod +x "${BT_TEMP_DIR}/vendor/acme/scripts/devshell/v_single.sh"
  cat > "${BT_TEMP_DIR}/vendor/acme/scripts/devshell/fx_host_tools.json" <<'EOF'
{
  "v-single-sh": {
    "category": "Build",
    "script": "//vendor/acme/scripts/devshell/v_single.sh",
    "summary": "vendor single-sh summary"
  }
}
EOF

  # 1. fx <registered-script-cmd>
  : > "${BT_TEMP_DIR}/_py_calls.log"
  local out_cmd
  out_cmd="$("${fx}" single-sh arg1 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out_cmd}" "SINGLE_SH_OK|arg1"
  BT_EXPECT_EQ "$(_count_py_calls)" 1

  # 2. fx help <registered-script-cmd>
  : > "${BT_TEMP_DIR}/_py_calls.log"
  local help_sh
  help_sh="$("${fx}" help single-sh 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${help_sh}" "usage: fx single-sh [--flag]"
  BT_EXPECT_EQ "$(_count_py_calls)" 1

  # 3. fx help <registered-target-cmd> (unbuilt)
  : > "${BT_TEMP_DIR}/_py_calls.log"
  local help_unbuilt
  help_unbuilt="$("${fx}" help single-target-unbuilt 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${help_unbuilt}" "unbuilt target summary"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${help_unbuilt}" "Run fx single-target-unbuilt --help"
  BT_EXPECT_EQ "$(_count_py_calls)" 1

  # 4. fx help <registered-target-cmd> (built)
  : > "${BT_TEMP_DIR}/_py_calls.log"
  local help_built
  help_built="$("${fx}" help single-target-built 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${help_built}" "BUILT_TARGET_HELP"
  BT_EXPECT_EQ "$(_count_py_calls)" 1

  # 5. fx help --full
  : > "${BT_TEMP_DIR}/_py_calls.log"
  local help_full
  help_full="$("${fx}" help --full 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${help_full}" "single-sh"
  BT_EXPECT_EQ "$(_count_py_calls)" 1

  # 6. fx-command-run <registered-script-cmd>
  : > "${BT_TEMP_DIR}/_py_calls.log"
  local out_run
  out_run="$(
    source "${BT_TEMP_DIR}/tools/devshell/lib/vars.sh" || exit $?
    fx-command-run single-sh from-run 2>/dev/null
  )"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out_run}" "SINGLE_SH_OK|from-run"
  BT_EXPECT_EQ "$(_count_py_calls)" 1

  # 7. tools/devshell/vendor direct invocation
  : > "${BT_TEMP_DIR}/_py_calls.log"
  local out_vendor
  out_vendor="$("${BT_TEMP_DIR}/tools/devshell/vendor" acme v-single-sh 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out_vendor}" "V_SINGLE_OK|"
  BT_EXPECT_EQ "$(_count_py_calls)" 1
}

