  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out_sh}" "SH_OK|FLAG=0|ARGS=--alpha 1"

  out_py="$(PATH="/usr/bin:/bin" "${fx}" mock-py --beta 2 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out_py}" "PY_SIBLING_OK|FLAG=0|ARGS=--beta 2"

  help_sh="$("${fx}" help mock-sh 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${help_sh}" "usage: fx mock-sh [--arg]"

  help_py="$("${fx}" help mock-py 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${help_py}" "usage: fx mock-py [--arg]"

  full_help="$("${fx}" help --full 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${full_help}" "mock-sh"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${full_help}" "mock shell bootstrap command"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${full_help}" "mock-py"

  local caller_script="${BT_TEMP_DIR}/tools/devshell/caller-script-cmd"
  cat > "${caller_script}" <<EOF
