TEST_registry_lookup() {
  source "${BT_TEMP_DIR}/tools/devshell/lib/vars.sh"
  source "${BT_TEMP_DIR}/tools/devshell/lib/fx-cmd-locator.sh"

  if declare -f get_registered_host_tool_scope >/dev/null 2>&1; then
    BT_FAIL "get_registered_host_tool_scope should not exist; all tools live in \$FUCHSIA_BUILD_DIR/host-tools"
  fi

  local target
  target="$(get_registered_host_tool_target "my-reg-tool")"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${target}" "//scripts/developer:my-reg-tool"

  target="$(get_registered_host_tool_target "other-tool")"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${target}" "//tools/other:other_bin"

  BT_EXPECT_FAIL get_registered_host_tool_target "nonexistent-tool"

  mkdir -p "${BT_TEMP_DIR}/vendor/acme/scripts/devshell"
  cat > "${BT_TEMP_DIR}/vendor/acme/scripts/devshell/fx_host_tools.json" <<'EOF'
{
  "acme-tool": "//vendor/acme/tools:acme-tool"
}
EOF
  target="$(get_registered_host_tool_target "acme-tool" "acme")"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${target}" "//vendor/acme/tools:acme-tool"

  rm -rf "${BT_TEMP_DIR}/out/default/host-tools"
  BT_EXPECT_EQ "$(get_registered_host_tool_install_path "my-reg-tool")" "${BT_TEMP_DIR}/out/default/host-tools/my-reg-tool"
}

